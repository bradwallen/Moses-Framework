#!/usr/bin/env bash
# moses-inventory — describe Reserve as it actually is, into the memory corpus.
#
#   moses-inventory            write ~/.claude/memory/infrastructure.md
#   moses-inventory --print    print it instead, change nothing
#
# WHY (Brad, 2026-08-12): *"If I ask Moses about ANYTHING infrastructure related he should be able to
# tell me that answer."* He couldn't. A migration script died looking for CRON_SECRET in the wrong
# env file, and no amount of retrieval would have helped, because that fact existed in exactly one
# place — a `for` loop inside /usr/local/bin/moses. Retrieval only reaches what someone wrote down.
#
# So this does not ask anyone to write anything down. It INTERROGATES THE MACHINE and writes what it
# finds, on a timer. A hand-kept note describes what someone last remembered; this describes what is.
# When something drifts, the file changes — which is the difference between finding out now and
# finding out two weeks later when a script fails.
#
# TWO RULES IT WILL NOT BREAK:
#
#  1. NEVER A SECRET VALUE. Variable NAMES only, and only from files this user can already read.
#     Root-only files are reported as existing, with their mode and — far more usefully — WHICH
#     SCRIPTS READ THEM, derived by grepping the scripts themselves. That mapping is the exact fact
#     whose absence cost the migration run, and it needs no privilege to establish.
#  2. NO PRIVILEGE REQUIRED. It runs as brad under a systemd USER timer. Anything it cannot see, it
#     says it cannot see, rather than quietly omitting it — an inventory with silent gaps is worse
#     than none, because it reads as complete.

set -uo pipefail
# Whose home, where Moses lives, and the operator's own settings (agent/lib/moses-env.sh).
. "$(dirname "$(readlink -f "$0")")/lib/moses-env.sh"
# colon-separated setting → one item per line
_list() { printf '%s\n' "${1:-}" | tr ':' '\n' | sed '/^$/d'; }

OUT="$HOME/.claude/memory/infrastructure.md"
PRINT=0
[ "${1:-}" = "--print" ] && PRINT=1

# Where to look for scripts that consume config. Used to answer "who reads this file?".
SCRIPT_DIRS=(/usr/local/bin "$MOSES_HOME/scripts" "$MOSES_ROOT/knight/bin" /opt/moses)

# Config and secret files worth tracking. Listed explicitly: a wildcard sweep would rot into noise,
# and the point is the handful of files that decide whether things work.
# The operator adds their own (a product's .env, a persona's config) in MOSES_INVENTORY_CONFIG_FILES.
CONFIG_FILES=(
  /etc/moses/moses.env
  /etc/moses/roster.json
  "$MOSES_CONFIG_DIR/knight.env"
  "$MOSES_ROOT/knight/guards.env"
)
while IFS= read -r _f; do CONFIG_FILES+=("$_f"); done < <(_list "${MOSES_INVENTORY_CONFIG_FILES:-}")

emit() { printf '%s\n' "$*"; }

# Which scripts reference a given path. This is the highest-value line in the whole file: it turns
# "where does CRON_SECRET live" into a question the machine answers, instead of one someone recalls.
readers_of() {
  local path="$1" hits=""
  for d in "${SCRIPT_DIRS[@]}"; do
    [ -d "$d" ] || continue
    while IFS= read -r f; do
      b=$(basename "$f")
      # A backup copy, a memory note that merely mentions the path, or this script itself are not
      # readers. Listing them buries the handful of names that actually answer the question.
      case "$b" in *.bak*|*.md|*.new|moses-inventory) continue ;; esac
      hits="$hits $b"
    done < <(grep -rls -- "$path" "$d" 2>/dev/null | head -12)
  done
  printf '%s' "$(echo "$hits" | tr ' ' '\n' | sort -u | tr '\n' ' ' | sed 's/^ *//;s/ *$//')"
}

# Variable NAMES defined in a file. Values are never read, never printed — the sed keeps the name and
# discards everything from the '=' onward before anything is emitted.
var_names_of() {
  grep -hoE '^[[:space:]]*(export[[:space:]]+)?[A-Z][A-Z0-9_]*=' "$1" 2>/dev/null \
    | sed 's/^[[:space:]]*//; s/^export[[:space:]]*//; s/=.*//' | sort -u | tr '\n' ' '
}

build() {
emit "# Infrastructure — Reserve and friends"
emit
emit "**GENERATED by \`moses-inventory\` — do not hand-edit.** Written $(date '+%A %Y-%m-%d %H:%M %Z')."
emit "Anything here is what the machine reported at that moment, not what anyone remembered."
emit "Secret VALUES are never read or written — variable names only, and only from readable files."
emit

# ── Hosts ───────────────────────────────────────────────────────────────────
emit "## Hosts on the tailnet"
emit
if command -v tailscale >/dev/null 2>&1; then
  emit '```'
  tailscale status 2>/dev/null | sed 's/[[:space:]]\+/ /g' | cut -c1-110
  emit '```'
  emit
  # Machines that must stay OUT of reach — someone else's, shared on the tailnet for one purpose.
  # MOSES_MUST_NOT_REACH="who|host|address;…".
  #
  # `tailscale ping --icmp`, and the flag is the whole check. Measured 2026-09-21: a PLAIN `tailscale
  # ping` (and --tsmp) got a pong from a machine that ICMP through the tunnel could not reach — they
  # answer below the traffic the policy governs, so the old check's verdict depended only on whether
  # the path happened to be warm (it said "not reachable" at 13:06 and "REACHABLE" at 13:08, nothing
  # changed in between). ICMP is real traffic through WireGuard. Its limit, said rather than hidden: a
  # reply proves reachable; NO reply is the policy OR that machine's own firewall, and this cannot tell
  # which. An SSH probe is worse still — a Windows box runs no SSH server whatever the policy says.
  while IFS='|' read -r _who _host _ip; do
    [ -n "${_ip:-}" ] || continue
    emit "**${_who} must NOT be reachable from here.**"
    if timeout 15 tailscale ping --icmp --c 2 --timeout 6s "$_ip" 2>/dev/null | grep -q '^pong'; then
      emit "- 🔴 \`${_host}\` (${_ip}) — **answers ICMP through the tunnel: REACHABLE.** Narrow the"
      emit "  policy; do not rely on the absence of an SSH server."
    else
      emit "- ✅ \`${_host}\` (${_ip}) — no reply to ICMP through the tunnel. Blocked by the policy or by"
      emit "  that machine's firewall; this check cannot tell which (the admin console can)."
    fi
    emit
  done < <(printf '%s\n' "${MOSES_MUST_NOT_REACH:-}" | tr ';' '\n')
  emit "Reachability from $(hostname) right now:"
  while read -r ip host _; do
    [ -n "${ip:-}" ] || continue
    case "$ip" in 100.*) ;; *) continue ;; esac
    # Skip this machine — "can bamaserv ssh to bamaserv" is not a fact worth reporting.
    [ "$host" = "$(hostname)" ] && continue
    if timeout 6 ssh -o BatchMode=yes -o ConnectTimeout=4 "brad@$ip" true 2>/dev/null; then
      emit "- \`$host\` (\`$ip\`) — SSH reachable as brad"
    else
      emit "- \`$host\` (\`$ip\`) — no SSH from here (no key, or not permitted)"
    fi
  done < <(tailscale status 2>/dev/null | awk 'NF>=2 {print $1, $2}')
else
  emit "_tailscale CLI not present_"
fi
emit

# ── Services ────────────────────────────────────────────────────────────────
emit "## Services"
emit
# DENYLIST, NOT AN ALLOWLIST — and this is the whole point of the section.
#
# Until 2026-09-01 these two lists matched services against a hardcoded set of names
# (moses|birdeye|knight|cloudflared|caddy|postgres|tailscale|travel|viatica). Anything nobody thought
# to add was invisible: 33 of 37 running services, including `code-server@brad` (the editor Brad
# works inside every day), `idrivecron` (the backup Birdeye reports on) and `smbd` (whose
# 0.0.0.0:445 bind was the surprise in the Tailscale ACL incident). An allowlist IS silent omission,
# and this file's own rules forbid exactly that: "an inventory with silent gaps is worse than none,
# because it reads as complete."
#
# So: show everything running, minus recognized distro plumbing, and SAY HOW MANY were set aside.
# Anything Brad installs from now on appears here by itself — the property that was missing.
NOISE='^[[:space:]]*(systemd-|dbus|polkit|cron\.|rsyslog|udisks|upower|accounts-daemon|ModemManager|avahi|bluetooth|colord|switcheroo|wpa_supplicant|unattended|packagekit|snapd|apparmor|irqbalance|thermald|smartd|multipathd|gdm|rtkit|cups|fwupd|kerneloops|power-profiles|low-memory|plymouth|e2scrub|blk-availability|finalrd|keyboard-setup|console-setup|setvtrgb|user@|user-runtime|pipewire|wireplumber|filter-chain|mpris-proxy|gcr-|gnome-keyring|xdg-|at-spi|dconf|evolution|gvfs|tracker)'

emit "### System"
emit '```'
systemctl list-units --type=service --state=running --no-legend 2>/dev/null \
  | grep -ivE "$NOISE" \
  | awk '{printf "%-34s %-8s %-10s %s\n", $1, $3, $4, $5}'
emit '```'
_sys_hidden=$(systemctl list-units --type=service --state=running --no-legend 2>/dev/null | grep -icE "$NOISE")
emit "> Running units only. **${_sys_hidden}** further running units are recognized distro plumbing"
emit "> (systemd-*, dbus, cups, snapd and the like) and are not listed. Nothing else is filtered:"
emit "> a service you install shows up here by itself."
emit
emit "### User (systemd --user, no privilege needed to deploy)"
emit '```'
XDG_RUNTIME_DIR="/run/user/$(id -u)" systemctl --user list-units --type=service --state=running --no-legend 2>/dev/null \
  | grep -ivE "$NOISE" \
  | awk '{printf "%-38s %-8s %-10s %s\n", $1, $3, $4, $5}'
emit '```'
_usr_hidden=$(XDG_RUNTIME_DIR="/run/user/$(id -u)" systemctl --user list-units --type=service --state=running --no-legend 2>/dev/null | grep -icE "$NOISE")
emit "> **${_usr_hidden}** further user units are desktop-session plumbing (pipewire, keyring, xdg-*)"
emit "> and are not listed." 
emit
emit "> \`systemctl --user\` needs \`XDG_RUNTIME_DIR=/run/user/1000\` set, or it reports nothing and"
emit "> looks exactly like a stopped service. That has cost a wrong diagnosis more than once."
emit

# ── Timers ──────────────────────────────────────────────────────────────────
emit "## Scheduled work"
emit
emit '```'
{ systemctl list-timers --all --no-legend 2>/dev/null
  XDG_RUNTIME_DIR="/run/user/$(id -u)" systemctl --user list-timers --all --no-legend 2>/dev/null
} | grep -iE 'moses|birdeye|knight|backup|reserve|inventory|discovery|transcript' \
  | awk 'NF' | sed 's/[[:space:]]\+/ /g' | cut -c1-100 | head -12
emit '```'
emit

# ── Config ──────────────────────────────────────────────────────────────────
emit "## Configuration and secret files"
emit
emit "Which file holds which setting, and — the part that is hard to recall and easy to get wrong —"
emit "**which scripts read it**. Derived by grepping the scripts, so it stays true as they change."
emit
for f in "${CONFIG_FILES[@]}"; do
  if [ ! -e "$f" ]; then
    emit "### \`$f\`"
    emit "- **does not exist**"
    emit
    continue
  fi
  emit "### \`$f\`"
  emit "- $(stat -c 'owner %U:%G · mode %a · %s bytes · modified %y' "$f" 2>/dev/null | cut -c1-72)"
  local_readers=$(readers_of "$f")
  emit "- read by: ${local_readers:-_nothing found in the searched script directories_}"
  if [ -r "$f" ]; then
    names=$(var_names_of "$f")
    [ -n "$names" ] && emit "- defines: \`${names% }\`" || emit "- defines: _(not a KEY=value file)_"
  else
    emit "- **not readable as $(whoami)** — root-only by design; variable names not listed"
  fi
  emit
done

# ── Listeners ───────────────────────────────────────────────────────────────
emit "## Listening ports"
emit
emit '```'
ss -ltnp 2>/dev/null | awk 'NR>1 {print $4, $6}' | sed 's/users:((//; s/))//' | sort -u | head -14
emit '```'
emit

# ── Cloudflare Access ───────────────────────────────────────────────────────
emit "## Cloudflare Access"
emit
CF_ENV="$HOME/.config/moses/cloudflare.env"
if [ ! -r "$CF_ENV" ]; then
  emit "_No read-only Cloudflare token configured (\`$CF_ENV\`), so Access configuration is not"
  emit "visible from here. A lone 24-hour session duration on \`moses-origin\` — among one-month"
  emit "settings everywhere else — killed the MCP connector daily until it was found by hand._"
else
  # shellcheck disable=SC1090
  cf_token=$(. "$CF_ENV" 2>/dev/null; printf '%s' "${CLOUDFLARE_API_TOKEN:-}")
  if [ -z "$cf_token" ]; then
    emit "_\`$CF_ENV\` exists but defines no CLOUDFLARE_API_TOKEN._"
  else
    cf_get() { curl -sS --max-time 20 -H "Authorization: Bearer $cf_token" "https://api.cloudflare.com/client/v4$1" 2>/dev/null; }
    # Prefer an explicitly configured account id. A token scoped to Access permissions CANNOT
    # enumerate accounts — /accounts answers success with ZERO results, which is not a failure and
    # must not be reported as one. The first version said "token invalid, expired, or missing
    # permissions" for that case: three causes, one message, and the true cause was none of them.
    cf_acct=$(. "$CF_ENV" 2>/dev/null; printf '%s' "${CLOUDFLARE_ACCOUNT_ID:-}")
    if [ -n "$cf_acct" ]; then
      acct="$cf_acct"
    else
      acct=$(cf_get "/accounts" | python3 -c "
import json,sys
try:
    d=json.load(sys.stdin)
    print(d['result'][0]['id'] if d.get('success') and d.get('result') else '')
except Exception: print('')" 2>/dev/null)
    fi

    if [ -z "$acct" ]; then
      emit "⚠️ _No account id. An Access-scoped token cannot list accounts — \`/accounts\` returns"
      emit "success with zero results, which is correct behavior, not a failure. Set"
      emit "\`CLOUDFLARE_ACCOUNT_ID\` in \`$CF_ENV\` (the hex id in the dashboard URL)._"
    else
      emit "### Applications — session duration"
      emit
      emit "The setting that decides whether a connector survives the night. **A policy-level value"
      emit "overrides the application's**, so policies are fetched too and shown when they differ."
      emit
      emit '```'
      # Fetch apps, then each app's policies, and let PYTHON decide what is anomalous — by comparing
      # each duration against the LONGEST one present, not against a hardcoded list of suspicious
      # values. The first version listed '24h','12h','1h'... which would have sailed past a 48h
      # outlier among 730h. The signal is "one of these is not like the others", so compute it.
      apps_json=$(cf_get "/accounts/$acct/access/apps")
      pol_json="{}"
      for app_id in $(printf '%s' "$apps_json" | python3 -c "
import json,sys
try:
    for a in (json.load(sys.stdin).get('result') or []): print(a.get('id',''))
except Exception: pass" 2>/dev/null); do
        [ -n "$app_id" ] || continue
        p=$(cf_get "/accounts/$acct/access/apps/$app_id/policies")
        pol_json=$(printf '%s\n%s' "$pol_json" "$p")
      done
      printf '%s' "$apps_json" | python3 /dev/fd/3 3<<'CFAPPS'
import json, re, sys

def hours(v):
    """Duration to hours. Cloudflare uses forms like '730h', '24h', '30m', '0s' (0s = never expires)."""
    if not v: return None
    m = re.fullmatch(r"(\d+(?:\.\d+)?)\s*([smhd])", str(v).strip())
    if not m: return None
    n, unit = float(m.group(1)), m.group(2)
    return n * {"s": 1/3600, "m": 1/60, "h": 1, "d": 24}[unit]

try:
    apps = json.load(sys.stdin).get("result") or []
except Exception:
    apps = []
if not apps:
    print("(no applications returned)")
    raise SystemExit

rows = [(a.get("name") or "?", a.get("session_duration") or "(inherits global)") for a in apps]
vals = [h for h in (hours(v) for _, v in rows) if h is not None]
longest = max(vals) if vals else None

for name, sd in rows:
    h = hours(sd)
    flag = ""
    # Anything under half the longest is the odd one out — that is the shape of the moses-origin
    # bug, where a single 24h sat among one-month settings and killed the connector nightly.
    if h is not None and longest and h < longest / 2:
        flag = "  <-- SHORTER THAN THE REST"
    print(f"{name[:34]:36} {sd:>12}{flag}")

if longest:
    print(f"\n(longest is {longest:.0f}h; anything under {longest/2:.0f}h is flagged)")
CFAPPS
      emit '```'
      emit
      # Policies, which OVERRIDE the application value. Only worth printing when one actually
      # carries its own duration — otherwise it is noise that buries the case that matters.
      pol_out=$(printf '%s' "$pol_json" | python3 /dev/fd/3 3<<'CFPOL'
import json, sys
found = []
for chunk in sys.stdin.read().split("\n"):
    chunk = chunk.strip()
    if not chunk or chunk == "{}":
        continue
    try:
        d = json.loads(chunk)
    except Exception:
        continue
    for p in (d.get("result") or []):
        sd = p.get("session_duration")
        if sd:
            found.append(f"  {(p.get('name') or '?')[:34]:36} {sd}")
if found:
    print("Policies carrying their OWN session duration (these WIN over the application value):")
    print("\n".join(found))
CFPOL
)
      if [ -n "$pol_out" ]; then
        emit '```'
        emit "$pol_out"
        emit '```'
      else
        emit "_No policy overrides a session duration — the application values above are what apply._"
      fi
      emit
      emit "### Service tokens — expiry"
      emit
      emit '```'
      cf_get "/accounts/$acct/access/service_tokens" | python3 -c "
import json,sys,datetime
try:
    d=json.load(sys.stdin); toks=d.get('result') or []
except Exception:
    toks=[]
if not toks:
    print('(no service tokens returned)')
now=datetime.datetime.now(datetime.timezone.utc)
for t in toks:
    exp=t.get('expires_at')
    left=''
    if exp:
        try:
            e=datetime.datetime.fromisoformat(exp.replace('Z','+00:00'))
            days=(e-now).days
            left=f'{days}d left' + ('  <-- EXPIRING' if days<45 else '')
        except Exception: left=exp
    print(f\"{(t.get('name') or '?')[:34]:36} {left or 'no expiry'}\")
" 2>/dev/null
      emit '```'
    fi
  fi
fi
emit

# ── Deployments ─────────────────────────────────────────────────────────────
emit "## Deployments"
emit
# What the operator runs and where — their own words, from $MOSES_CONFIG_DIR/estate.md.
if [ -r "$MOSES_CONFIG_DIR/estate.md" ]; then cat "$MOSES_CONFIG_DIR/estate.md"; emit; fi
if command -v git >/dev/null 2>&1; then
  while IFS= read -r r; do
    [ -d "$r/.git" ] || continue
    emit "- \`$r\` — branch \`$(git -C "$r" rev-parse --abbrev-ref HEAD 2>/dev/null)\`," \
         "head \`$(git -C "$r" rev-parse --short HEAD 2>/dev/null)\`," \
         "remotes: $(git -C "$r" remote 2>/dev/null | tr '\n' ' ' | sed 's/ *$//' || echo none)"
  done < <(_list "${MOSES_WATCH_REPOS:-}"; echo "$MOSES_ROOT/knight/repo")
fi
emit

emit "## Backups"
emit
emit '```'
while IFS= read -r _b; do
  ls -la "$_b" 2>/dev/null | tail -n +2 | awk '{printf "%-12s %s\n", $5, $9}' | head -8
done < <(_list "${MOSES_BACKUP_DIRS:-}")
emit '```'
emit
emit "_Refresh with \`moses-inventory\`; it runs daily under \`moses-inventory.timer\` (user unit)._"
}

if [ "$PRINT" -eq 1 ]; then
  build
else
  mkdir -p "$(dirname "$OUT")"
  tmp=$(mktemp)
  build > "$tmp"
  # A secret value must never reach the corpus. Refuse to publish if anything smells like one, and
  # say so loudly — a guard that fails quietly is not a guard.
  if grep -qE '(sk-ant-[A-Za-z0-9]|re_[A-Za-z0-9]{10}|sk_live_|whsec_|postgres(ql)?://[^ ]*:[^ ]*@)' "$tmp"; then
    echo "REFUSING TO WRITE: output contains something shaped like a credential" >&2
    rm -f "$tmp"; exit 1
  fi
  mv -f "$tmp" "$OUT"
  echo "wrote $OUT ($(wc -l < "$OUT") lines)"
fi
