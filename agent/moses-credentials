#!/usr/bin/env python3
"""moses-credentials — every credential this account can see, described without one value in it.

    moses-credentials                 write ~/.claude/memory/credentials.md
    moses-credentials --print         print it instead, change nothing
    moses-credentials --live          also ask GitHub and Cloudflare when their tokens expire

WHY (2026-11-06): Atlas's credential hardening started with a read-only survey of every provider
credential on their box, and the survey is what found the worst of it: a key readable by every account,
an admin key nobody remembered, old copies in archive folders. Reserve had no such list. MF8 part 5 has a
hand-made table of five files; this is that table, made by the machine, on the inventory's timer.

WHAT IT WRITES, per file: owner, mode, age, the NAMES of the variables that look like secrets, which
scripts read the file (by grepping them), and for a `.bak` copy whether each secret in it is the same as
the live file's (a duplicate) or different (an OLD secret, which is only harmless if it was revoked).

RULES, the same as moses-inventory's: never a value, not even a hash of one (values are compared in
memory and only the verdict is written); no privilege; and what it cannot see it says it cannot see.
The file is mode 600, unlike infrastructure.md: it is the operator's map of where his secrets are, and
the agent's account (which reads the corpus since MF8) has no need of it.
"""
from __future__ import annotations

import glob
import json
import os
import pwd
import re
import stat
import subprocess
import sys
import time
import urllib.request
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
try:
    from moses_env import setting as _setting        # the process env first, then moses.env
except Exception:                                    # noqa: BLE001 — a framework copy without it still runs
    def _setting(key: str, default: str = "") -> str:
        return os.environ.get(key, default)

HOME = Path(os.environ.get("MOSES_CREDENTIALS_HOME") or pwd.getpwuid(os.geteuid()).pw_dir)
OUT = Path(os.environ.get("MOSES_CREDENTIALS_OUT") or HOME / ".claude" / "memory" / "credentials.md")

# Where credentials live on a machine like this one. Globs, relative to HOME unless absolute. The
# operator adds their own in MOSES_CREDENTIAL_PATHS (colon-separated).
DEFAULT_PATHS = [
    ".config/moses/*", ".config/*/*.env", ".config/*/*.token", ".config/*/*.json",
    ".wrangler/config/*", ".config/.wrangler/config/*",
    ".ssh/*", ".claude/.credentials.json", ".aws/credentials", ".config/gh/hosts.yml",
    "Projects/*/.env", "Projects/*/.env.*", "Projects/*/.dev.vars",
    "/etc/moses/*",
]
# Folders that hold credentials this account is not meant to read. Listed so the gap is said out loud.
def _agent_config() -> list[str]:
    """The agent account's config folder, when it is not this account (MF8's /etc/moses/agent-user)."""
    try:
        agent = Path("/etc/moses/agent-user").read_text().strip()
        home = pwd.getpwnam(agent).pw_dir
    except (OSError, KeyError):
        return []
    return [] if agent == pwd.getpwuid(os.geteuid()).pw_name else [f"{home}/.config/moses"]


DEFAULT_OPAQUE = _agent_config() + ["/root"]
SCRIPT_DIRS = ["/usr/local/bin", "scripts", "Projects/moses/agent", "Projects/moses/mcp",
               "Projects/moses/knight/bin", ".config/systemd/user", "/etc/systemd/system"] + \
              [d for d in _setting("MOSES_CREDENTIAL_SCRIPT_DIRS", "").split(":") if d]
# Files a program reads by convention rather than by naming them in a script.
CONVENTIONAL = [(re.compile(r"/Projects/([^/]+)/\.(env|dev\.vars)(\.[^/]*)?$"), r"the app in Projects/\1 (its own .env)"),
                (re.compile(r"/\.wrangler/config/"), "the wrangler CLI (its own login)"),
                (re.compile(r"/\.config/gh/"), "the gh CLI (its own login)"),
                (re.compile(r"/\.aws/credentials$"), "the AWS CLI and SDKs"),
                (re.compile(r"/\.claude/\.credentials\.json$"), "Claude Code (its own login)")]

SECRET_NAME = re.compile(r"(TOKEN|SECRET|PASSWORD|PASSWD|_KEY$|^KEY$|API_KEY|PRIVATE|CREDENTIAL|WEBHOOK|"
                         r"DATABASE_URL|_DSN$|AUTH_)", re.I)
NOT_SECRET = re.compile(r"(_ID$|_URL$|_CHANNEL|_NAME$|_HOST$|_PORT$|_EMAIL$|_FROM_)", re.I)
SKIP_SUFFIX = (".example", ".sample", ".pub", "known_hosts", "known_hosts.old", "config", "authorized_keys")


def _paths(setting: str, defaults: list[str]) -> list[str]:
    extra = [p for p in _setting(setting, "").split(":") if p]
    return defaults + extra


def expand(patterns: list[str]) -> list[Path]:
    seen, out = set(), []
    for pat in patterns:
        full = pat if pat.startswith("/") else str(HOME / pat)
        for p in sorted(glob.glob(full)):
            path = Path(p)
            if path in seen or path.is_dir() or path.name.endswith(SKIP_SUFFIX):
                continue
            seen.add(path)
            out.append(path)
    return out


def is_secret_name(name: str) -> bool:
    return bool(SECRET_NAME.search(name)) and not (NOT_SECRET.search(name) and not
                                                  re.search(r"(TOKEN|SECRET|PASSWORD|KEY)", name, re.I))


def read_vars(path: Path) -> dict[str, str] | None:
    """NAME -> value for KEY=VALUE files; JSON top-level and one level down; None if unreadable.
    The values never leave this process."""
    try:
        text = path.read_text(errors="replace")
    except OSError:
        return None
    if path.suffix == ".json":
        try:
            d = json.loads(text)
        except ValueError:
            return {}
        out = {}
        def walk(obj, prefix=""):
            if isinstance(obj, dict):
                for k, v in obj.items():
                    if isinstance(v, (str, int)) and not isinstance(v, bool):
                        out[f"{prefix}{k}"] = str(v)
                    elif isinstance(v, dict) and not prefix:
                        walk(v, f"{k}.")
        walk(d)
        return out
    if "PRIVATE KEY-----" in text:
        return {"(private key)": text}
    out = {}
    for line in text.splitlines():
        m = re.match(r"\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_.]*)\s*=\s*(.*)$", line)
        if m:
            out[m.group(1)] = m.group(2).strip().strip("'\"")
    return out


GENERIC = {".env", ".dev.vars", "config", "default.toml", "credentials", "hosts.yml", ".credentials.json"}


def readers_of(path: Path) -> list[str]:
    """Scripts that name this file. A generic name (.env, config) is searched with its folder
    ("brads-travel-project/.env"), or every script that reads any .env would be listed."""
    name = path.name
    if ".bak" in name:
        return []
    if name in GENERIC or name.startswith(".env."):
        name = f"{path.parent.name}/{path.name}"
    hits = set()
    dirs = [d if d.startswith("/") else str(HOME / d) for d in SCRIPT_DIRS]
    dirs = [d for d in dirs if os.path.isdir(d)]
    if not dirs:
        return []
    r = subprocess.run(["grep", "-rlsIF", "--exclude=*.bak*", "--exclude=*_test.*", "--exclude=*.md", "--exclude=*.pyc",
                        "--exclude=*.db", "--exclude-dir=__pycache__",
                        "--exclude-dir=node_modules", "--exclude-dir=.git", "--exclude-dir=venv", name, *dirs],
                       capture_output=True, text=True, timeout=60)
    for line in r.stdout.splitlines():
        if line.endswith("moses-credentials"):
            continue
        hits.add(line.replace(str(HOME) + "/", "~/"))
    return sorted(hits)


def live_of(path: Path) -> Path | None:
    """The live file a .bak copy was taken from: everything before '.bak'."""
    if ".bak" not in path.name:
        return None
    live = path.with_name(path.name.split(".bak")[0])
    return live if live.exists() else None


def age(path: Path) -> str:
    days = int((time.time() - path.lstat().st_mtime) // 86400)
    return f"{days}d"


def check_live(name: str, value: str) -> str:
    """Expiry as the provider reports it. Only GitHub and Cloudflare, only with --live."""
    try:
        if name == "GH_TOKEN":
            req = urllib.request.Request("https://api.github.com/user", headers={
                "Authorization": f"token {value}", "User-Agent": "moses-credentials"})
            with urllib.request.urlopen(req, timeout=10) as r:
                exp = r.headers.get("github-authentication-token-expiration") or "never"
            return f"GitHub: valid, expires {exp}"
        if name.startswith("CLOUDFLARE") and "TOKEN" in name:
            req = urllib.request.Request("https://api.cloudflare.com/client/v4/user/tokens/verify", headers={
                "Authorization": f"Bearer {value}", "User-Agent": "moses-credentials"})
            with urllib.request.urlopen(req, timeout=10) as r:
                res = json.load(r).get("result", {})
            return f"Cloudflare: {res.get('status')}, expires {res.get('expires_on') or 'NEVER'}"
    except urllib.error.HTTPError as e:
        return f"provider answered {e.code} (dead or not this kind of token)"
    except Exception as e:                                   # noqa: BLE001
        return f"could not ask ({type(e).__name__})"
    return ""


def build(live: bool = False) -> str:
    files = expand(_paths("MOSES_CREDENTIAL_PATHS", DEFAULT_PATHS))
    rows, findings, opaque = [], [], []
    for path in files:
        try:
            st = path.lstat()
        except OSError:
            continue
        if stat.S_ISLNK(st.st_mode):
            continue
        mode = st.st_mode & 0o777
        owner = pwd.getpwuid(st.st_uid).pw_name if st.st_uid in [p.pw_uid for p in pwd.getpwall()] else st.st_uid
        values = read_vars(path)
        if values is None:
            rows.append((path, owner, mode, age(path), "(cannot read here)", "", ""))
            continue
        secrets = {k: v for k, v in values.items() if v and (is_secret_name(k) or k == "(private key)")}
        if not secrets:
            continue
        rel = ""
        src = live_of(path)
        if src:
            live_vals = read_vars(src) or {}
            same = [k for k, v in secrets.items() if live_vals.get(k) == v]
            old = [k for k, v in secrets.items() if k in live_vals and live_vals[k] != v]
            gone = [k for k in secrets if k not in live_vals]
            parts = []
            if same:
                parts.append(f"same as live: {', '.join(same)}")
            if old:
                parts.append(f"OLD value: {', '.join(old)}")
                findings.append(f"`{path}` holds an OLD value of {', '.join(old)}: harmless only if that "
                                f"credential was revoked")
            if gone:
                parts.append(f"no longer in live: {', '.join(gone)}")
            rel = "; ".join(parts)
            if same and not old and not gone:
                findings.append(f"`{path}` is a duplicate copy of live secrets ({', '.join(same)})")
        elif ".bak" in path.name:
            rel = "its live file is gone"
            findings.append(f"`{path}` is a copy of secrets whose live file is gone")
        if mode & 0o077:
            findings.append(f"`{path}` is mode {oct(mode)[2:]}: readable beyond its owner")
        readers = readers_of(path)
        if not readers:
            readers = [m.expand(label) for rx, label in CONVENTIONAL if (m := rx.search(str(path)))]
        if not readers and ".bak" not in path.name and not str(path).startswith("/etc/"):
            findings.append(f"`{path}` has no reader in the scanned scripts (possibly dead, or read by a "
                            f"program outside them)")
        notes = []
        if live:
            # A .bak's copy of a live value says nothing new; its OLD and orphaned values are the ones
            # worth asking about: an old secret that still works is a live credential nobody tracks.
            asked = secrets if not src else {k: v for k, v in secrets.items()
                                             if (read_vars(src) or {}).get(k) != v}
            for k, v in asked.items():
                n = check_live(k, v)
                accepted = n.startswith(("GitHub: valid", "Cloudflare: active"))
                if accepted and ".bak" in path.name:
                    findings.append(f"`{path}` holds a {k} that the provider still ACCEPTS, and the live "
                                    f"file does not have it: revoke it at the provider, then delete the copy")
                if n:
                    notes.append(f"{k}: {n}")
        rows.append((path, owner, mode, age(path), ", ".join(sorted(secrets)), rel or ", ".join(readers),
                     "; ".join(notes)))
    for d in _paths("MOSES_CREDENTIAL_OPAQUE", DEFAULT_OPAQUE):
        try:
            os.stat(d)
            if not os.access(d, os.R_OK | os.X_OK):
                opaque.append(d)
        except PermissionError:                # cannot even look inside the folder above it
            opaque.append(d)
        except OSError:
            pass

    out = [f"# Credentials on this machine (generated — never hand-edit)", "",
           f"_Written {time.strftime('%A %Y-%m-%d %H:%M %Z')} by `agent/moses-credentials` as "
           f"{pwd.getpwuid(os.geteuid()).pw_name}. Variable NAMES only: no value, and no hash of one._", ""]
    out += ["## Findings", ""] + ([f"- {f}" for f in findings] or ["- none"]) + [""]
    if opaque:
        out += ["## Not visible to this account", ""]
        out += [f"- `{d}`: exists, and this account cannot read it (another account's or root's)" for d in opaque]
        out += [""]
    out += ["## Every file", "", "| file | owner | mode | age | secrets (names) | read by / copy of | live |",
            "|---|---|---|---|---|---|---|"]
    for path, owner, mode, a, names, rel, notes in rows:
        shown = str(path).replace(str(HOME) + "/", "~/")
        out.append(f"| `{shown}` | {owner} | {oct(mode)[2:]} | {a} | {names} | {rel} | {notes} |")
    out.append("")
    return "\n".join(out)


def main() -> int:
    text = build(live="--live" in sys.argv)
    if "--print" in sys.argv:
        print(text)
        return 0
    OUT.parent.mkdir(parents=True, exist_ok=True)
    tmp = OUT.with_suffix(".tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(text)
    os.replace(tmp, OUT)
    print(f"wrote {OUT}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
