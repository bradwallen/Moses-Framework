#!/usr/bin/env bash
# knight-run — the detached worker. Not called by hand; `knight start` launches it.
#
#   knight-run <job-dir> <repo> <branch>
#
# WHY THIS IS ITS OWN FILE
# The permission lists are ARRAYS containing patterns with spaces, like "Bash(git push:*)".
# Threading arrays through a quoted `bash -c` and back out of positional parameters is exactly how
# they got flattened into a string and silently shredded by word-splitting. This sources guards.env
# directly and expands "${KNIGHT_ALLOW[@]}" properly, so the rules that run are the rules as written.
#
# ── THE PUSH IS DONE HERE, NOT BY THE AGENT ──────────────────────────────────
# Brad reviews the description and then looks at the feature in Viatica, so Knight's work has to
# reach Customs. That does NOT mean handing the agent push rights:
#
#   * `Bash(git push:*)` stays denied for the agent, and the guard suite proves it fires.
#   * The remote is added only AFTER the gate is green, and removed immediately after the push. For
#     the entire window the agent is running, the clone still has no remote — which was the original
#     guarantee, and that window is where it matters.
#   * The gate is objective and run HERE, in plain bash: the full vitest suite and tsc --noEmit.
#     Not "the agent said tests pass" — an agent reporting its own green light is the thing that
#     makes an unattended push dangerous. Red means no push, and the Slack report says so.

set -uo pipefail
. "$(dirname "$(readlink -f "$0")")/../../agent/lib/moses-env.sh"   # whose home, where Moses lives, the operator's settings

DIR="$1"; REPO="$2"; BRANCH="$3"; TARGET="${4:-viatica}"; INCIDENT="${5:-}"
# shellcheck disable=SC1091
source "$MOSES_ROOT/knight/guards.env"
# The registry says what the gate is and where green work lands. Sourced here rather than passed in,
# so the runner reads the same file `knight doctor` and `knight targets` print — one source of truth
# for the three places that describe a target.
# The same defaults `knight`'s load_target sets first. Without them a target file that leaves out an
# optional field (KT_PUSH_REMOTE is one) killed this runner on its first line under `set -u` — and the
# job stayed "running" forever, because the runner is what would have written anything else. Found
# 2026-09-21 with a target written by test-runner.sh.
KT_DESC=""; KT_SOURCE=""; KT_BRANCH=""; KT_PUSH_MODE=""; KT_PUSH_REMOTE=""; KT_PREP=(); KT_GATE=()
# shellcheck disable=SC1090
source "$MOSES_ROOT/knight/targets/$TARGET.env" || { echo failed > "$DIR/status"; exit 1; }
[ -n "$KT_PUSH_REMOTE" ] || KT_PUSH_REMOTE=$(git -C "$KT_SOURCE" remote get-url origin 2>/dev/null)
OPTENV=$MOSES_CONFIG_DIR/knight.env
# THE ONE RUNNER (M20, 2026-09-14). The builder's and the reviewer's command lines are built by
# agent/claude-run from guards.env, with --restricted and --strict-mcp-config always on and --tools and
# --allowedTools built from one declaration. It execs the CLI, so the timeouts below still reach the
# CLI itself, and result.json keeps the CLI's own shape.
RUNNER=$MOSES_ROOT/agent/claude-run

cd "$REPO" || { echo failed > "$DIR/status"; exit 1; }

# ── Check the idea against the code before building it ───────────────────────
# Brad, 2026-10-01: "when I say to implement it, re-do the homework before tasking Knight, because
# there can be drift since I work in both Slack and Claude Code." Proposal 6848b820 reached Knight
# asking him to extend a mechanism that exists in Atlas's system and not in ours; Knight found that
# out himself, at the last possible moment. Now a read-only scout asks first — against THIS clone,
# freshly fetched, which is exactly the code about to be built on, so drift cannot slip past it.
#
# A false premise or work already done ends the job here: no build, and the report says what the
# code actually holds. A grounded task hands Knight the findings. A check that could not run does
# NOT block — it is said, in the brief and in the report, and Knight is told to verify the premise
# himself. A guard that failed closed on its own outage would be switched off the first week.
#
# KNIGHT_FAKE_SCOUT is the test seam: its text stands in for the scout's answer, verdict first.
precheck_refused=0
if [ -n "${KNIGHT_FAKE_SCOUT:-}" ]; then
    printf '%b\n' "$KNIGHT_FAKE_SCOUT" > "$DIR/precheck.txt"
elif [ -z "${KNIGHT_FAKE_AGENT:-}" ]; then
    # The CRITERIA are checked too, not only the task: on 2026-09-27 a criterion asked Knight to guard
    # code that Brave's browser injects, so the right build was blocked by a ruler nobody could meet.
    { cat "$DIR/task.txt"; [ -s "$DIR/acceptance.txt" ] && { printf '\n\nACCEPTANCE CRITERIA:\n'; cat "$DIR/acceptance.txt"; }; } \
        > "$DIR/precheck-input.txt"
    python3 "$MOSES_ROOT/agent/scout.py" --repo "$REPO" --task-file "$DIR/precheck-input.txt" \
        > "$DIR/precheck.txt" 2>> "$DIR/stderr.log" \
        || printf 'COULD_NOT_CHECK\nthe scout exited non-zero\n' > "$DIR/precheck.txt"
fi
if [ -s "$DIR/precheck.txt" ]; then
    precheck_verdict=$(head -1 "$DIR/precheck.txt")
    case "$precheck_verdict" in
      PREMISE_FALSE|ALREADY_DONE)
          precheck_refused=1 ;;
      COULD_NOT_CHECK)
          { printf 'PRE-CHECK: the task was NOT checked against the code before this job (%s). Verify its premise yourself before building, and stop and report if what it assumes is not here.\n\n' \
                "$(sed -n 2p "$DIR/precheck.txt")"; cat "$DIR/brief.txt"; } > "$DIR/brief.txt.new" \
              && mv "$DIR/brief.txt.new" "$DIR/brief.txt" ;;
      *)  { printf 'PRE-CHECK (read-only scout, this checkout as fetched): %s\n' "$precheck_verdict"
            sed -n '2,$p' "$DIR/precheck.txt"
            printf 'This is what exists right now. Build from it; if it is wrong, say so in the report.\n\n'
            cat "$DIR/brief.txt"; } > "$DIR/brief.txt.new" && mv "$DIR/brief.txt.new" "$DIR/brief.txt" ;;
    esac
fi

# ── Run the agent ────────────────────────────────────────────────────────────
# KNIGHT_FAKE_AGENT is a TEST SEAM, not a feature: it substitutes `sleep N` for the model so the
# timeout/kill/record path can be proven in seconds instead of an hour, and without spending any of
# Brad's Pro allowance. The wall-clock SIGKILL is the backstop the entire unattended design leans
# on, and it went a full day untested while `doctor` printed "wall-clock ceiling 60 min" with total
# confidence — a claim nobody had ever exercised. It gets exercised now.
if [ "$precheck_refused" -eq 1 ]; then
    # NO BUILD. The scout's findings become the report, in the same result shape the builder writes,
    # so everything downstream — the report file, the classifier, the Slack post — needs no special case.
    python3 -c 'import json,sys; json.dump({"result": open(sys.argv[1]).read(), "is_error": False,
        "permission_denials": []}, open(sys.argv[2], "w"))' "$DIR/precheck.txt" "$DIR/result.json"
    rc=0
elif [ -n "${KNIGHT_FAKE_AGENT:-}" ]; then
    timeout --signal=TERM --kill-after=5 "$KNIGHT_TIMEOUT_SEC" \
        sleep "$KNIGHT_FAKE_AGENT" > "$DIR/result.json" 2> "$DIR/stderr.log"
    rc=$?
else
    timeout --signal=TERM --kill-after=30 "$KNIGHT_TIMEOUT_SEC" \
        "$RUNNER" --app knight-builder --prompt-file "$DIR/brief.txt" \
        > "$DIR/result.json" 2> "$DIR/stderr.log"
    rc=$?
fi

commits=$(git -C "$REPO" rev-list --count FETCH_HEAD.."$BRANCH" 2>/dev/null || echo 0)
CARD="$(dirname "$(readlink -f "$0")")/../lib/card.py"
if [ "$rc" -eq 0 ] && [ "$commits" -gt 0 ]; then
    "$CARD" "$DIR" checking "Knight finished ($commits commit(s)); running the checks." \
        --next "Review, then it lands or waits for you." >/dev/null 2>&1 || true
fi
report=$(python3 -c "
import json
try: print(json.load(open('$DIR/result.json')).get('result') or '')
except Exception: print('')" 2>/dev/null)
printf '%s\n' "$report" > "$DIR/report.txt"

# A REFUSED TOOL IS NOT A SUCCESS (M20). The CLI exits 0 when a tool is quietly denied, so the run is
# classified as ok, degraded or failed and recorded, and a degraded build says what it was refused in
# the report Brad reads.
perm=$("$RUNNER" --classify "$DIR/result.json" 2>/dev/null || echo "unclassified")
printf '%s\n' "$perm" > "$DIR/permission.txt"
case "$perm" in
    degraded*) printf '\n_Refused during the build: %s_\n' "${perm#degraded: }" >> "$DIR/report.txt" ;;
esac

# ── Reading the review's verdict ─────────────────────────────────────────────
# Lives in lib/review-verdict.sh, because `knight-land` has to make the SAME judgement before it
# merges a branch as this makes before it pushes one. Two copies would drift, and the drift would
# be invisible until a branch landed that this runner would have blocked.
source "$(dirname "$0")/../lib/review-verdict.sh"
source "$(dirname "$0")/../lib/examples.sh"     # Brad's confirmed examples are tests (#3)
# The stalled-job diagnosis — measured against the real mainline, so a blocked report carries a
# verdict (re-run vs genuine human merge, with the files) rather than a guess. See the lib's header.
source "$(dirname "$0")/../lib/diagnose-branch.sh"


run_review() {
    # Extracted 2026-09-04 so it can run on BOTH paths. It used to live inside the
    # successful-rebase branch, which meant the one class of build most likely to need a
    # second pair of eyes — the one that could not land cleanly — was the only class that got
    # none. Moses spotted that within minutes of the first real end-to-end run: "a conflict is
    # a merge problem, not a correctness problem; the diff was still reviewable."
    #
    # It does not push and never has. Whether the work lands is decided by the caller.
    # Atlas, 2026-09-02: the reviewer being a separate agent from the author is the
    # load-bearing part, not the review itself. An agent reading its own diff is a green
    # that was never able to go red. And his sharper correction: a gate the checked thing
    # invokes is still self-review even if it is compiled — so this is a fixed step in the
    # runner, never something the brief asks the builder to run.
    #
    # CONFIRMED blocks the push exactly like a red test. PLAUSIBLE is recorded and the push
    # proceeds, so "there might be a problem here" can neither quietly stop the build nor
    # quietly vanish.
    #
    # A REVIEW THAT COULD NOT RUN BLOCKS. Not "could not look, therefore fine" — that is the
    # failure this whole estate keeps paying for. If the reviewer times out, crashes or
    # returns something unparseable, nothing ships and the report says exactly why.
    review_ok=1; review_why=""; plausible=""; unchecked=""
    if [ "${regate:-1}" -eq 1 ]; then
        # THREE dots: from the merge-base, i.e. only what this branch changed. Two dots compares the
        # two trees, so on a branch behind the mainline — exactly the failed-rebase case, where this
        # still runs — every newer mainline commit appears as something the branch "reverts". On
        # 2026-09-27 that made Zryachiy call the evidence unusable and read the files by hand. After a
        # successful rebase the two are identical, so this costs nothing there.
        git -C "$REPO" diff FETCH_HEAD...HEAD > "$DIR/review.diff" 2>/dev/null
        if [ -n "${KNIGHT_FAKE_AGENT:-}" ]; then
            # Test seam, same as the builder: exercise the parse and the block/allow paths
            # without spending any of Brad's allowance.
            printf '%s\n' "${KNIGHT_FAKE_REVIEW:-CLEAN}" > "$DIR/review.txt"
            rrc=0
        else
            timeout --signal=TERM --kill-after=15 "$KNIGHT_REVIEW_TIMEOUT_SEC" \
                "$RUNNER" --app zryachiy-reviewer --prompt-file "$DIR/review-brief.txt" --add-dir "$DIR" \
                > "$DIR/review.json" 2> "$DIR/review.err"
            rrc=$?
            "$RUNNER" --classify "$DIR/review.json" > "$DIR/review-permission.txt" 2>/dev/null
            python3 -c "
import json,sys
try: sys.stdout.write(json.load(open('$DIR/review.json')).get('result') or '')
except Exception: pass" > "$DIR/review.txt" 2>/dev/null
        fi

        review_verdict "$rrc" "$DIR/review.txt"

        # ONE MORE ASK FOR A MISSING VERDICT — asked, never inferred. 2026-10-01: a green build was
        # thrown away because the review settled six criteria in detail and left out the one word
        # the runner reads. Guessing CLEAN from that prose would be a model talking its way to a pass;
        # discarding the build was the opposite waste. So the same reviewer gets the same brief again
        # with the rule it skipped spelled out, once. Still no verdict: the block stands, said twice.
        if [ "$rrc" -eq 0 ] && [ "${review_noverdict:-0}" -eq 1 ]; then
            mv "$DIR/review.txt" "$DIR/review-first.txt"
            { cat "$DIR/review-brief.txt"
              printf '\n\nYOUR PREVIOUS REVIEW OF THIS DIFF HAD NO VERDICT LINE, so it could not be read and blocked\n'
              printf 'the change. Review it again and START with the verdict lines: one CONFIRMED, MISSED or\n'
              printf 'PLAUSIBLE line per finding, or the single word CLEAN when the change is sound and every\n'
              printf 'criterion is met. A criterion you cannot judge from the diff is MISSED, naming what you\n'
              printf 'could not check. Then the SETTLED lines.\n'; } > "$DIR/review-brief-retry.txt"
            if [ -n "${KNIGHT_FAKE_AGENT:-}" ]; then
                printf '%s\n' "${KNIGHT_FAKE_REVIEW_RETRY:-}" > "$DIR/review.txt"; rrc=0
            else
                timeout --signal=TERM --kill-after=15 "$KNIGHT_REVIEW_TIMEOUT_SEC" \
                    "$RUNNER" --app zryachiy-reviewer --prompt-file "$DIR/review-brief-retry.txt" --add-dir "$DIR" \
                    > "$DIR/review-retry.json" 2>> "$DIR/review.err"
                rrc=$?
                python3 -c "
import json,sys
try: sys.stdout.write(json.load(open('$DIR/review-retry.json')).get('result') or '')
except Exception: pass" > "$DIR/review.txt" 2>/dev/null
            fi
            review_verdict "$rrc" "$DIR/review.txt"
            [ "${review_noverdict:-0}" -eq 1 ] && review_why="$review_why, even after being asked twice"
        fi

        # ── The review, as one line on the run's status card ─────────────────
        # Zryachiy used to post his own message (2026-09-04, "put him in the dev channel"). Brad,
        # 2026-10-17: too many messages from too many agents, each a black box until the next. His
        # verdict is now a line on the ONE card the run keeps (lib/card.py), said in plain words.
        if [ "$review_ok" -eq 1 ] && [ -z "$plausible" ]; then
            zline="Review: clean — no defects, and it does what was asked."
        elif [ "$review_ok" -eq 1 ]; then
            zline="Review: passes, with $(printf '%s\n' "$plausible" | grep -c .) note(s) recorded on the commit."
        else
            zline="Review blocked it: $(printf '%s' "$review_why" | head -c 220)"
        fi
        [ "${rebase_failed:-0}" -eq 1 ] && zline="$zline (advisory — the branch could not be rebased, so nothing lands from this run)"
        "$(dirname "$(readlink -f "$0")")/../lib/card.py" "$DIR" reviewing "$zline" >/dev/null 2>&1 || true
    fi
}

# ── The gate ─────────────────────────────────────────────────────────────────
gate_ok=0; gate_why=""; rebase_failed=0
if [ "$rc" -eq 124 ] || [ "$rc" -eq 137 ]; then
    gate_why="hit the ${KNIGHT_TIMEOUT_SEC}s wall-clock ceiling and was killed"
elif [ "$rc" -ne 0 ]; then
    gate_why="the agent exited $rc"
elif [ "$commits" -eq 0 ]; then
    gate_why="nothing was committed, so there is nothing to push"
else
    # Every command from the target's KT_GATE, in order, first red wins. Named in the failure so the
    # report says which check failed rather than "the gate failed" — Brad reads the report, not the log.
    : > "$DIR/gate.log"
    # PREP AGAIN WHEN THE JOB CHANGED WHAT PREP INSTALLS. Prep runs before the agent starts, outside
    # his sandbox, because only it has network. The first GIS job (2026-10-17) wrote a prep.sh that
    # installs TypeScript, but prep had already run — the placeholder one — so the gate's type check
    # found no TypeScript, went red, and 901 lines of tested work never reached a branch. Re-run only
    # when a dependency or setup file changed: Viatica's prep is a full install, and running it on
    # every job would double the wait for nothing.
    if git -C "$REPO" diff --name-only "$(git -C "$REPO" merge-base FETCH_HEAD "$BRANCH" 2>/dev/null)" "$BRANCH" 2>/dev/null \
        | grep -qE '(^|/)(prep\.sh|package(-lock)?\.json|pnpm-lock\.yaml|yarn\.lock|requirements[^/]*\.txt|pyproject\.toml|poetry\.lock|Pipfile(\.lock)?|go\.(mod|sum)|Cargo\.(toml|lock)|Gemfile(\.lock)?)$'; then
        echo "== prep again: the job changed a dependency or setup file ==" >> "$DIR/gate.log"
        for step in ${KT_PREP+"${KT_PREP[@]}"}; do
            ( cd "$REPO" && bash -c "$step" >> "$DIR/gate.log" 2>&1 ) \
                || echo "== prep step failed: $step (the gate will say what that broke) ==" >> "$DIR/gate.log"
        done
    fi
    gate_ok=1
    for step in "${KT_GATE[@]}"; do
        echo "== gate: $step ==" >> "$DIR/gate.log"
        if ! ( cd "$REPO" && bash -c "$step" >> "$DIR/gate.log" 2>&1 ); then
            gate_ok=0
            gate_why="the gate failed at: $step"
            # Say what nobody could tell from the log: whether Knight broke it, or arrived to it
            # already broken. A stale generated artifact in the clone made every Viatica job red for
            # a week while the reports blamed the work. `knight provision` runs this same gate on an
            # untouched checkout and answers it in one command.
            gate_why="$gate_why (if this looks unrelated to the task, run: knight provision $TARGET — it runs the same gate on an untouched $KT_BRANCH)"
            break
        fi
    done
    # THE CONFIRMED EXAMPLES ARE PART OF THE GATE (#3). Each example Brad agreed to before the build must
    # be named by a test in the branch; the gate above ran those tests. One with no test is a missed
    # requirement, so the job is held and knight-next follows it up with this line as what held it.
    if [ "$gate_ok" -eq 1 ] && [ -s "$DIR/examples.txt" ]; then
        ex_missing=$(examples_missing "$REPO" "$DIR/examples.txt")
        if [ -n "$ex_missing" ]; then
            gate_ok=0
            gate_why="a confirmed example has no test that names it: $ex_missing"
            echo "== confirmed examples: NO TEST names: $ex_missing ==" >> "$DIR/gate.log"
        else
            echo "== confirmed examples: each one has a test ($(wc -l < "$DIR/examples.txt")) ==" >> "$DIR/gate.log"
        fi
    fi
fi

# ── Push, only on green ──────────────────────────────────────────────────────
pushed=0; push_note=""
# Never let git stop and ask. Without these it can block on a credential prompt or an unknown host
# key until the wall-clock ceiling kills it — turning a one-line auth failure into a lost hour of
# Brad's allowance. GIT_TERMINAL_PROMPT=0 makes https fail fast; BatchMode does the same for ssh.
export GIT_TERMINAL_PROMPT=0
export GIT_SSH_COMMAND='ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new'
if [ "$gate_ok" -eq 1 ]; then
    # The mainline moves: Brad and other sessions push while Knight works. Rebase onto the current
    # tip rather than force anything, and re-run the gate afterwards — a clean rebase can still break
    # the build when someone else changed what this code depends on.
    if git -C "$REPO" fetch -q "$KT_PUSH_REMOTE" "$KT_BRANCH" 2>>"$DIR/gate.log"; then
        # Pinned now: later steps fetch and diff, and FETCH_HEAD is not a stable name to diagnose against.
        main_sha=$(git -C "$REPO" rev-parse FETCH_HEAD)
        # --autostash BECAUSE THE BUILD DIRTIES THE TREE AND THAT IS NORMAL. 2026-09-04, the
        # first real end-to-end run: `npm install` rewrote package-lock.json (Viatica's committed
        # lockfile disagrees with its package.json), git refused with "cannot rebase: You have
        # unstaged changes", and the whole chain stopped. Uncommitted files were never going to be
        # pushed anyway — only commits are — so blocking on them protected nothing.
        if git -C "$REPO" rebase -q --autostash FETCH_HEAD >>"$DIR/gate.log" 2>&1; then
            regate=1
            for step in "${KT_GATE[@]}"; do
                echo "== re-gate after rebase: $step ==" >> "$DIR/gate.log"
                ( cd "$REPO" && bash -c "$step" >> "$DIR/gate.log" 2>&1 ) || { regate=0; break; }
            done
            run_review

            if [ "$regate" -eq 1 ] && [ "$review_ok" -eq 1 ]; then
                # PLAUSIBLE travels with the code. A message-only amend cannot change what the gate
                # just proved, and git log is where the next person actually looks.
                if [ -n "$plausible" ]; then
                    git -C "$REPO" commit -q --amend --no-edit -m "$(git -C "$REPO" log -1 --pretty=%B)

Review (unconfirmed, recorded rather than blocking):
$plausible" 2>>"$DIR/gate.log" || true
                fi
                # UNCHECKED travels the same way: what the review could not judge from a diff, for
                # whoever checks the live thing. Recorded, never mistaken for a pass.
                if [ -n "${unchecked:-}" ]; then
                    git -C "$REPO" commit -q --amend --no-edit -m "$(git -C "$REPO" log -1 --pretty=%B)

Not checkable from the diff (for whoever checks it live):
$unchecked" 2>>"$DIR/gate.log" || true
                fi
                git -C "$REPO" remote add push-target "$KT_PUSH_REMOTE" 2>/dev/null
                # WHERE GREEN WORK LANDS — the one difference between the two modes, and it is read
                # from the registry, never decided here. `direct` lands on the mainline and deploys.
                # `branch` pushes the work branch and stops: the repositories that RUN Knight get a
                # human between a green gate and a merge, because a change there can break the gate
                # that would have caught it.
                if [ "$KT_PUSH_MODE" = direct ]; then
                    refspec="HEAD:$KT_BRANCH"
                else
                    refspec="HEAD:refs/heads/$BRANCH"
                fi
                if git -C "$REPO" push -q push-target "$refspec" >>"$DIR/gate.log" 2>&1; then
                    pushed=1
                    push_note="$(git -C "$REPO" rev-parse --short HEAD)"
                    [ "$KT_PUSH_MODE" = direct ] || push_note="$push_note on branch $BRANCH — NOT merged"
                else
                    gate_why="push was rejected — see gate.log"
                fi
                # Off again immediately. The clone must be remote-less whenever an agent runs.
                git -C "$REPO" remote remove push-target 2>/dev/null
            elif [ "$regate" -eq 0 ]; then
                gate_why="the gate passed alone but FAILED after rebasing onto current $KT_BRANCH — someone else's change conflicts with this work"
                git -C "$REPO" rebase --abort 2>/dev/null
            else
                # SAY WHICH GATE STOPPED IT. This branch used to blame the rebase for everything,
                # and with a review step in front of the push that would have reported a blocking
                # finding as somebody else's merge conflict — sending Brad to look at the wrong thing.
                gate_why="$review_why"
                git -C "$REPO" rebase --abort 2>/dev/null
            fi
        else
            # SAY WHAT ACTUALLY FAILED. This asserted a merge conflict for EVERY rebase failure. On
            # 2026-09-04 the real error was "cannot rebase: You have unstaged changes" — the build
            # had rewritten package-lock.json — and the report sent Brad, Moses and Claude all
            # looking for a conflict that did not exist. Naming a cause nobody observed is the
            # failure this estate keeps paying for; a message is a claim like any other.
            rb_err=$(tail -20 "$DIR/gate.log" | grep -iE "^(error|fatal|CONFLICT)" | tail -2 | tr '\n' ' ')
            case "$rb_err" in
              *CONFLICT*|*"could not apply"*)
                    # Not "needs a human merge" any more: a rebase replays commit by commit and can
                    # conflict where the finished change would merge cleanly. The diagnosis below
                    # decides which, and that verdict is what Brad should be asked to act on.
                    gate_why="the rebase onto $KT_BRANCH conflicted" ;;
              *"unstaged changes"*|*"local changes"*)
                    gate_why="the rebase could not start: the working tree was dirty ($rb_err)" ;;
              "")   gate_why="the rebase onto $KT_BRANCH failed and git printed no error this runner could find — see gate.log" ;;
              *)    gate_why="the rebase onto $KT_BRANCH failed: $rb_err" ;;
            esac
            git -C "$REPO" rebase --abort 2>/dev/null
            rebase_failed=1
            # MEASURE BEFORE ANYONE IS ASKED. Read-only, no model, no tokens.
            gate_why="$gate_why · DIAGNOSIS: $(diagnose_branch "$REPO" "$main_sha")"
            # REVIEW IT ANYWAY. Nothing will be pushed — but the diff is readable, and the person
            # who now has to merge by hand should start from a verdict instead of an unreviewed
            # change. Moses, 2026-09-04: "review is wired behind a clean rebase, which means the one
            # class of build most likely to need a second pair of eyes is exactly the class that
            # gets none."
            regate=1
            run_review
            case "$review_ok" in
              0) gate_why="$gate_why · Zryachiy ALSO blocked it: $review_why" ;;
              *) gate_why="$gate_why · Zryachiy reviewed it anyway and did not block" ;;
            esac
        fi
    else
        gate_why="could not fetch $KT_BRANCH to rebase onto"
    fi
fi

# ── Did it actually reach customers, and is it working? ──────────────────────
#
# THE GATE RUNS IN A CLONE AND NEVER LEAVES THE PROCESS. Brad proved that by sabotage: a totally
# broken PDF import passed the whole 711-test suite. So a green gate plus a successful push says the
# code was pushed — it says nothing about whether the deploy landed or whether the product still
# works for the people using it.
#
# Brad, 2026-09-04: "both report back to Moses that the deployment was a success". This is the half
# that makes that sentence honest rather than assumed.
#
# TWO SOURCES, AND THEY ANSWER DIFFERENT QUESTIONS.
#   1. Railway's own deployment record — the DECLARATION that our commit built and went live.
#   2. The running product answering over the internet — the BEHAVIOR.
# Either alone is the failure this estate keeps paying for. A platform can report SUCCESS for a
# container that crash-loops on first request, and a site can answer 200 while still serving the
# previous build.
#
# ONLY ON A TARGET THAT ACTUALLY DEPLOYS. `branch` targets land for a human to merge, so there is
# nothing live to verify and nothing to roll back.
deploy_state=""; deploy_why=""; rolled_back=0
if [ "$pushed" -eq 1 ] && [ "$KT_PUSH_MODE" = direct ]; then
    sha_full=$(git -C "$REPO" rev-parse HEAD)
    sha_short=$(git -C "$REPO" rev-parse --short HEAD)
    CUSTOMS_ENV=$MOSES_CONFIG_DIR/customs.env
    app_url=""; app_sec=""
    if [ -r "$CUSTOMS_ENV" ]; then
        # shellcheck disable=SC1090
        app_url=$(. "$CUSTOMS_ENV"; printf '%s' "${MOSES_APP_URL:-${VIATICA_APP_URL:-}}")
        app_sec=$(. "$CUSTOMS_ENV"; printf '%s' "${CRON_SECRET:-}")
    fi

    # A User-Agent is required, not cosmetic: Cloudflare answers a default curl agent with 403,
    # which reads exactly like an auth failure and once cost six days of wrong diagnosis.
    UA='Knight/1.0 (+viatica-ops)'
    probe() { curl -sS -o /dev/null -w '%{http_code}' --max-time 25 -A "$UA" "$@" 2>>"$DIR/deploy.log"; }

    {
        echo "== verifying deploy of $sha_short =="
        date -Is
    } >> "$DIR/deploy.log"

    # ── 1. Railway's record ──────────────────────────────────────────────────
    # Poll until our commit appears with a terminal status. A build takes minutes; the ceiling is
    # generous and running out is a FAILURE, never a pass. "Could not look" is not "looked and it
    # was fine" — the rule this whole estate keeps relearning.
    rw_state="unknown"
    for _i in $(seq 1 "${KT_DEPLOY_WAIT_TRIES:-40}"); do
        line=$(sudo -n railway-read deploys 2>>"$DIR/deploy.log" | grep -m1 -- "$sha_short" || true)
        case "$line" in
            *SUCCESS*)                 rw_state=success; break ;;
            *FAILED*|*CRASHED*)        rw_state=failed;  break ;;
        esac
        printf 'waiting for railway: %s\n' "${line:-our commit has not appeared yet}" >> "$DIR/deploy.log"
        sleep "${KT_DEPLOY_WAIT_SEC:-15}"
    done

    if [ "$rw_state" = failed ]; then
        deploy_state=failed; deploy_why="Railway reports the deployment of $sha_short FAILED"
    elif [ "$rw_state" != success ]; then
        deploy_state=unverified
        deploy_why="Railway never reported $sha_short as deployed within the wait — this is NOT a pass"
    else
        # ── 2. The product itself ────────────────────────────────────────────
        # Repeated on purpose. One 5xx during a rolling restart is normal; three in a row is the
        # deploy. Rolling back good code because Cloudflare hiccuped would be the false positive
        # that gets the whole mechanism switched off.
        if [ -z "$app_url" ] || [ -z "$app_sec" ]; then
            deploy_state=unverified
            deploy_why="deployed, but the credentials for $MOSES_PRODUCT_NAME are not on this box so nothing checked the live site"
        else
            bad=0; last=""
            for _i in 1 2 3; do
                home=$(probe "${app_url%/}/")
                deps=$(probe -H "Authorization: Bearer $app_sec" "${app_url%/}/api/health/deps")
                echo "attempt $_i: home=$home deps=$deps" >> "$DIR/deploy.log"
                if [ "$home" = 200 ] && [ "$deps" = 200 ]; then bad=0; break; fi
                bad=$((bad+1)); last="home=$home deps=$deps"
                sleep 10
            done
            if [ "$bad" -eq 0 ]; then
                deploy_state=live
                deploy_why="$sha_short is live and answering; dependencies green"
            else
                deploy_state=broken
                deploy_why="deployed, but the live site is not healthy after 3 checks ($last)"
            fi
        fi
    fi

    # ── 3. Pull the plug ─────────────────────────────────────────────────────
    # REVERT, NEVER RESET OR FORCE. A revert is a new commit: the history stays honest, the next
    # deploy is triggered the same way every other one is, and nothing anybody else pushed is lost.
    # Brad, 2026-09-04: Zryachiy should be "capable of pulling the plug if something is off".
    #
    # `unverified` deliberately does NOT roll back. Not knowing whether a deploy landed is not
    # evidence that it broke something, and reverting on ignorance would make a Railway API blip
    # revert good work. It is reported as loudly as a failure and left for a human.
    case "$deploy_state" in
      failed|broken)
        if [ "${KT_ROLLBACK:-1}" = 1 ]; then
            echo "== rolling back $sha_short ==" >> "$DIR/deploy.log"
            git -C "$REPO" remote add push-target "$KT_PUSH_REMOTE" 2>/dev/null
            if git -C "$REPO" revert --no-edit "$sha_full" >>"$DIR/deploy.log" 2>&1 &&
               git -C "$REPO" push -q push-target "HEAD:$KT_BRANCH" >>"$DIR/deploy.log" 2>&1; then
                rolled_back=1
                deploy_why="$deploy_why — ROLLED BACK, $(git -C "$REPO" rev-parse --short HEAD) reverts it"
            else
                # The worst case, and it must never be quiet: broken code is live and the way back
                # did not work either.
                deploy_why="$deploy_why — ROLLBACK ALSO FAILED. Broken code is live. See deploy.log"
            fi
            git -C "$REPO" remote remove push-target 2>/dev/null
        else
            deploy_why="$deploy_why — rollback is disabled for this target"
        fi ;;
    esac
    echo "$deploy_state: $deploy_why" >> "$DIR/deploy.log"
    # ── THE VERIFICATION LEDGER ──────────────────────────────────────────────
    # A DEPLOY THAT LANDED IS NOT A REQUEST THAT IS DONE. Brad, 2026-09-04: "a request isn't marked
    # as closed until everything is verified, even if I'm one of the holdups."
    #
    # Zryachiy judged the criteria against the DIFF. Nobody has yet judged them against the running
    # product, and some of them nobody in this pipeline can — an admin-gated change renders only for
    # a logged-in admin, and Moses gets a 307 to /login. Giving him an admin session was considered
    # and refused: this estate's line is that the agent never holds the credential.
    #
    # So the ledger names every criterion, says WHO can check it, and starts everything unverified.
    # A criterion Moses can reach is his; one marked [admin] is Brad's. The job is not done until
    # every row is verified, and the standup carries whatever is still open.
    if [ -s "$DIR/acceptance.txt" ]; then
        python3 - "$DIR/acceptance.txt" "$DIR/verification.json" "$deploy_state" "$DIR/review.txt" <<'PY'
import json, sys, datetime
crit_file, out_file, deploy = sys.argv[1], sys.argv[2], sys.argv[3]
review_file = sys.argv[4] if len(sys.argv) > 4 else None

# WHAT THE REVIEWER ALREADY SETTLED. Zryachiy reads the criteria one at a time against the diff, so
# the ones a diff CAN answer — a file deleted, a string absent, the gate green — are closed by him
# with the diff as evidence. Only what a diff cannot show reaches the live-site stage.
#
# Without this the ledger asked Moses to re-confirm "the test file is deleted" against a running
# website, which he cannot honestly do. Seven rows on 2026-09-04, five of them already settled at
# review time. Busywork in a ledger is how a ledger stops being read.
import re as _re
settled = {}
if review_file:
    try:
        for line in open(review_file, encoding="utf-8"):
            m = _re.match(r"\s*SETTLED:\s*(\d+)\s*[-—]\s*(.+)", line)
            if m:
                settled[int(m.group(1))] = m.group(2).strip()
    except OSError:
        pass
rows = []
for line in open(crit_file, encoding="utf-8"):
    text = line.strip().lstrip("-*• ").strip()
    if not text:
        continue
    # [admin] marks a criterion only Brad can see. Unmarked means Moses should be able to reach it —
    # and if he cannot, he says so rather than assuming it holds.
    who = "brad" if text.lower().startswith("[admin]") else "moses"
    n = len(rows) + 1
    # A reviewer may never settle an admin-gated row: he is reading a diff, and the whole reason
    # that row exists is that rendering is not visible in one.
    if n in settled and who != "brad":
        rows.append({"criterion": text, "checkable_by": who, "status": "verified",
                     "by": "zryachiy", "at": datetime.datetime.now().replace(microsecond=0).isoformat(),
                     "note": "from the diff: " + settled[n][:160]})
    else:
        rows.append({"criterion": text, "checkable_by": who, "status": "unverified",
                     "by": None, "at": None, "note": None})
json.dump({"deploy": deploy,
           "opened": datetime.datetime.now().replace(microsecond=0).isoformat(),
           "criteria": rows}, open(out_file, "w"), indent=2)
openn = [r for r in rows if r["status"] == "unverified"]
print(f"   verification ledger: {len(rows)} criterion(s), {len(rows) - len(openn)} settled by "
      f"Zryachiy from the diff, {len(openn)} open "
      f"({sum(1 for r in openn if r['checkable_by'] == 'brad')} need Brad)")
PY
    fi
    printf '%s\n' "$deploy_state" > "$DIR/deploy-state"
    printf '%s\n' "$deploy_why"   > "$DIR/deploy-why"
fi

# ── Close the incident this job came from, only if the work actually landed ──
#
# THE AGENT IS NOT INVOLVED IN THIS. It has no network, no credential and no way to reach Viatica —
# that sandbox is the reason Knight is safe to run unattended, and handing him an API token to tidy a
# queue would trade the whole guarantee for a convenience. So the close belongs here, in the runner,
# exactly like the push: the privileged step is taken by the thing that verified the work, never by
# the thing that did it.
#
# Green gate is not enough on its own — a green gate with nothing pushed means nothing shipped, and
# an incident closed against work that never reached anybody is a lie the queue then repeats.
if [ -n "$INCIDENT" ]; then
    # ROLLED BACK MEANS NOT FIXED. Closing an incident against a change that was reverted minutes
    # later tells the queue a lie it will then repeat back — the same reason a green gate alone was
    # never enough to close one.
    if [ "$pushed" -eq 1 ] && [ "$rolled_back" -eq 0 ] && [ "$deploy_state" != broken ] \
                           && [ "$deploy_state" != failed ]; then
        CUSTOMS_ENV=$MOSES_CONFIG_DIR/customs.env
        if [ -r "$CUSTOMS_ENV" ]; then
            # shellcheck disable=SC1090
            via_url=$(. "$CUSTOMS_ENV"; printf '%s' "${MOSES_APP_URL:-${VIATICA_APP_URL:-}}")
            via_sec=$(. "$CUSTOMS_ENV"; printf '%s' "${CRON_SECRET:-}")
            if [ -n "$via_url" ] && [ -n "$via_sec" ]; then
                note="fixed by Knight in ${push_note%% *} on $BRANCH ($TARGET)"
                # A User-Agent is required, not cosmetic: Cloudflare's bot rules answer a default
                # curl/urllib agent with a 403, which reads exactly like an auth failure.
                if curl -sS --max-time 20 -X POST "${via_url%/}/api/incidents/agent" \
                     -H "Authorization: Bearer $via_sec" \
                     -H "Content-Type: application/json" \
                     -H "User-Agent: Knight/1.0 (+viatica-ops)" \
                     --data "$(printf '{"id":"%s","resolved":true,"by":"knight","note":"%s"}' "$INCIDENT" "$note")" \
                     >>"$DIR/gate.log" 2>&1; then
                    incident_note="closed incident $INCIDENT"
                else
                    incident_note="COULD NOT close incident $INCIDENT — see gate.log"
                fi
            else
                incident_note="incident $INCIDENT left open — credentials for $MOSES_PRODUCT_NAME not configured on this box"
            fi
        else
            incident_note="incident $INCIDENT left open — $CUSTOMS_ENV unreadable"
        fi
    else
        # Say it rather than staying quiet. "I did not close it" is information; silence looks like
        # the incident was never attached to the job at all.
        incident_note="incident $INCIDENT left OPEN — nothing was pushed, so nothing is fixed"
    fi
fi

{
  echo "exit_code=$rc"
  echo "commits=$commits"
  echo "gate=$([ "$gate_ok" -eq 1 ] && echo green || echo "red: $gate_why")"
  [ -n "${incident_note:-}" ] && echo "incident=$incident_note"
  # Say WHY when a green build did not land. The summary used to print "gate=green / pushed=no" and
  # stop there, so the reason existed only in the Slack post — and `knight status` showed a job that
  # succeeded at everything with no hint of what went wrong at the last step.
  if [ "$pushed" -eq 1 ]; then
      echo "pushed=yes ($push_note)"
  else
      echo "pushed=no$([ "$gate_ok" -eq 1 ] && [ -n "$gate_why" ] && printf ' — %s' "$gate_why")"
  fi
  # WHAT HAPPENED AFTER THE PUSH, in the summary rather than only in Slack — `knight status` used
  # to show a job that succeeded at everything with no hint that the deploy then broke.
  case "${deploy_state:-}" in
    live)       echo "deploy=LIVE — $deploy_why" ;;
    broken)     echo "deploy=BROKEN — $deploy_why" ;;
    failed)     echo "deploy=FAILED — $deploy_why" ;;
    unverified) echo "deploy=UNVERIFIED — $deploy_why" ;;
  esac
  git -C "$REPO" diff --stat FETCH_HEAD.."$BRANCH" 2>/dev/null | tail -1
  if [ -n "$(git -C "$REPO" status --porcelain 2>/dev/null)" ]; then
      echo "UNCOMMITTED CHANGES LEFT IN THE TREE — not on the branch, not pushed:"
      git -C "$REPO" status --short 2>/dev/null | head -10
  fi
} > "$DIR/summary"

# THE STATUS IS WHAT ACTUALLY HAPPENED, not what was attempted. A job that pushed, broke Customs
# and reverted itself is not "pushed" — reading that word later would be actively misleading.
case "$rc" in
    124|137) echo timeout > "$DIR/status" ;;
    0)       if [ "$pushed" -ne 1 ]; then echo "done-not-pushed" > "$DIR/status"
             else
                 case "${deploy_state:-}" in
                   broken|failed) [ "$rolled_back" -eq 1 ] && echo "rolled-back" > "$DIR/status" \
                                                          || echo "deploy-broken" > "$DIR/status" ;;
                   unverified)    echo "deploy-unverified" > "$DIR/status" ;;
                   live)          if [ -s "$DIR/verification.json" ] && \
                                     python3 -c "
import json,sys
d=json.load(open('$DIR/verification.json'))
sys.exit(0 if any(c['status']=='unverified' for c in d['criteria']) else 1)" 2>/dev/null; then
                                      echo "awaiting-verification" > "$DIR/status"
                                  else
                                      echo "live" > "$DIR/status"
                                  fi ;;
                   *)             echo pushed > "$DIR/status" ;;
                 esac
             fi ;;
    *)       echo failed > "$DIR/status" ;;
esac
[ "$precheck_refused" -eq 1 ] && echo "refused-precheck" > "$DIR/status"
date +%Y-%m-%dT%H:%M:%S%z > "$DIR/ended"

# ── Slack ────────────────────────────────────────────────────────────────────
# The delivery format Brad already reads from every Viatica push: what shipped, what was decided,
# what is blocked, what is left. He does not read the diff, so the report IS the deliverable —
# a vague one is a failed delivery even when the code is fine.
# QUIET JOBS (started by knight-next) skip their report ONLY when the outcome is one knight-next
# speaks for: pushed (it lands it or follows up) or held with work committed (it follows up or asks
# Brad). EVERY other outcome — failed, timeout, rolled-back, deploy-broken, anything new — is posted
# as it always was. Review of 2026-10-17: "quiet" had hidden failure, which is never quiet's job.
_qst=$(cat "$DIR/status" 2>/dev/null)
_quiet_ok=0
[ -e "$DIR/quiet" ] && { [ "$_qst" = pushed ] || { [ "$_qst" = done-not-pushed ] && [ "${commits:-0}" -gt 0 ]; }; } && _quiet_ok=1
if [ -r "$OPTENV" ] && [ "$_quiet_ok" = 0 ]; then
    # shellcheck disable=SC1090
    tok=$(. "$OPTENV"; printf '%s' "${SLACK_BOT_TOKEN:-}")
    # Overridable so the suite does not post into the real channel — see bin/knight for why
    # this is an override and not a "do not post" flag.
    if [ -n "${KNIGHT_SLACK_CHANNEL+x}" ]; then chan=$KNIGHT_SLACK_CHANNEL; else
        chan=$(. "$OPTENV"; printf '%s' "${SLACK_KNIGHT_CHANNEL:-}"); fi
    if [ -n "$tok" ] && [ -n "$chan" ]; then
        # The FIRST LINE only. Brad briefs from his phone with a full spec (SCOPE…, REQUIREMENTS…),
        # and `head -c 300` dumped that wall into the quote block, burying the report under the ask.
        task=$(head -1 "$DIR/task.txt" | head -c 200)
        # SAY WHERE IT WENT, from the registry — not from a sentence written when Viatica was the
        # only target. This headline was hardcoded to "Pushed to `master` → Customs deploying" and
        # said that for EVERY successful job: for branch-mode work on the moses target, which lands
        # on a branch and deploys nothing, and for scratch runs during testing that never touched
        # Viatica at all. #viatica-dev carried a column of green ticks claiming deploys that had not
        # happened. The landing mode is the one distinction Brad asked for, and the report was the
        # one place it was thrown away.
        # "deploying" WAS A PROMISE, NOT A FACT. It said the same thing whether the deploy then
        # went live, crash-looped, or was reverted a minute later. Brad, 2026-09-04: the report has
        # to say the deployment succeeded, and mean it.
        # THE FIRST SECTION'S LABEL IS DECIDED HERE, BESIDE THE BANNER, so the two can never
        # disagree. Brad, 2026-09-08, after asking Knight to drop Labs from the Hardware page and
        # reading back that he had: the banner said "NOT merged, nothing is live" and the very next
        # line said "*What shipped* — the Hardware page now lists Reserve alone". Both were written
        # by the same honest run. The banner was right; the label is hardcoded and asserted an
        # outcome the message itself denied, and that is the line a human remembers.
        #
        # Set from the same conditions as $head rather than asked of the agent in the brief — a
        # label that must be correct is not something to request in prose and hope for.
        ship_label="What this would do"
        if [ "$precheck_refused" -eq 1 ]; then
            head="🔎 *$TARGET → not built* — checked against the code first: *$precheck_verdict*. Nothing was written."
            ship_label="What the code actually holds"
        elif [ "$pushed" -eq 1 ] && [ "$KT_PUSH_MODE" = direct ] && [ -n "${deploy_state:-}" ]; then
            case "$deploy_state" in
              live)       # LANDED IS NOT DONE. If criteria remain unverified the report says so and
                          # names the ones Brad has to look at himself — the request stays open until
                          # every row is ticked, including his.
                          pend=$(python3 -c "
import json
try: d=json.load(open('$DIR/verification.json'))
except Exception: raise SystemExit
u=[c for c in d['criteria'] if c['status']=='unverified']
b=[c for c in u if c['checkable_by']=='brad']
if u: print(f\"{len(u)}|{len(b)}\")" 2>/dev/null)
                          if [ -n "$pend" ]; then
                              head="🟡 *$TARGET → deployed, NOT yet done* · \`$push_note\` · ${pend%%|*} criterion(s) unverified, ${pend##*|} need Brad"
                          else
                              head="✅ *$TARGET → LIVE on \`$KT_BRANCH\`* · verified answering · \`$push_note\`"
                          fi
                          ship_label="What shipped" ;;
              broken|failed)
                          if [ "$rolled_back" -eq 1 ]; then
                              head="↩️ *$TARGET → ROLLED BACK* — the deploy was bad and has been reverted · $deploy_why"
                              # It shipped and was taken back out, so neither "shipped" nor "would do" is true.
                              ship_label="What was tried"
                          else
                              head="🔴 *$TARGET → BROKEN AND STILL LIVE* — $deploy_why"
                              ship_label="What shipped"
                          fi ;;
              unverified) head="⚠️ *$TARGET → pushed, DEPLOY UNVERIFIED* — $deploy_why"
                          ship_label="What shipped" ;;
              *)          head="✅ *$TARGET → pushed to \`$KT_BRANCH\`* · \`$push_note\`"
                          ship_label="What shipped" ;;
            esac
        elif [ "$pushed" -eq 1 ] && [ "$KT_PUSH_MODE" = direct ]; then
            head="✅ *$TARGET → pushed to \`$KT_BRANCH\`* · deploying · \`$push_note\`"
            ship_label="What shipped"
        elif [ "$pushed" -eq 1 ]; then
            head="✅ *$TARGET → pushed for review* · \`$BRANCH\` · NOT merged, nothing is live · \`${push_note%% *}\`"
        elif [ "$gate_ok" -eq 1 ]; then
            head="⚠️ *$TARGET → built but NOT pushed* — $gate_why"
        else
            head="🔴 *$TARGET → not pushed* — $gate_why"
        fi
        # Slack mrkdwn is NOT Markdown (bold is ONE asterisk; ** renders literally), and Brad
        # reads this on a phone — so the post is normalized AND collapsed to four lines here rather
        # than trusting the brief alone. The brief asks for compact; this guarantees it. A model
        # mid-coding-task will occasionally revert to the essay format it writes everywhere else,
        # and one verbose post trains him to stop reading the channel.
        slack_report=$(python3 - "$DIR/report.txt" "$ship_label" <<'CONV'
import re, sys

t = open(sys.argv[1]).read()
# What the first section is CALLED is decided by the runner from what actually landed, never by the
# agent writing the report. The brief still asks for "What shipped"; anything in SHIP_FAMILY is
# matched and re-emitted under the true label. A report cannot claim to have shipped work that is
# sitting on an unmerged branch, however it was written.
SHIP = sys.argv[2] if len(sys.argv) > 2 else "What shipped"
t = re.sub(r"\*\*(.+?)\*\*", r"*\1*", t, flags=re.S)          # **bold** -> *bold*
t = re.sub(r"^#{1,6}\s*(.+?)\s*$", r"*\1*", t, flags=re.M)     # ## Heading -> *Heading*

CAP = 400                                  # chars per line; Brad reads this on a phone
# Every name the first section has ever gone by, so an older report still parses and a future brief
# can reword it without silently falling through to the "unrecognized shape" branch below.
SHIP_FAMILY = ("What shipped", "What this would do", "What was tried")
LABELS = SHIP_FAMILY + ("Decisions", "Stoppers", "Notes")
lines, cur = [], None
for raw in t.splitlines():
    s = raw.strip()
    if not s:
        continue
    m = re.match(r"^\*(" + "|".join(LABELS) + r")\*\s*[—:-]?\s*(.*)$", s)
    if m:
        cur = [m.group(1), m.group(2).strip()]
        lines.append(cur)
    elif cur is not None:
        # A section written as a heading followed by prose: fold the prose up into its label.
        cur[1] = (cur[1] + " " + re.sub(r"^[-*\u2022]\s*", "", s)).strip()

if len(lines) >= 2:
    out = []
    for label, body in lines:
        body = re.sub(r"\s+", " ", body).strip() or "None."
        # Backstop only — the brief asks for two sentences, so this should rarely fire. Cut at a
        # SENTENCE boundary rather than mid-clause: a line ending "Behavior…" reads like a bug,
        # and the point of trimming is legibility on a phone, not hitting a character count.
        if len(body) > CAP:
            head = body[:CAP]
            # Semicolons and em-dashes count as boundaries too. With only ". ? !" this fell
            # through to the crude word-cut on every real report, because Opus writes long
            # semicolon-joined sentences and there was no period inside the cap.
            cut = max(head.rfind(". "), head.rfind("? "), head.rfind("! "),
                      head.rfind("; "), head.rfind(" — "))
            body = (head[:cut + 1] if cut > CAP // 3 else head.rsplit(" ", 1)[0] + "…")
        out.append(f"*{SHIP if label in SHIP_FAMILY else label}* — {body}")
    print("\n".join(out))
else:
    # Unrecognized shape: post it as-is rather than mangling it, but keep it bounded.
    print(t.strip()[:1500])
CONV
)
        # THE REPORT GOES UNDER THE RUN'S CARD, as one reply — not as its own channel post, and not a
        # second post to the conversation that asked (the card lives there). lib/card.py.
        printf '%s\n\n> %s\n\n%s\n' "$head" "$task" "$slack_report" > "$DIR/report-slack.txt"
        REPORT_REPLY=(--reply-file "$DIR/report-slack.txt")
    fi
fi

# ── This job's outcome on the run's status card ─────────────────────────────
# Every outcome updates the card. It PINGS Brad (a reply under the card; edits notify nobody) only when
# the outcome is final or needs him — not when knight-next is about to land it or follow it up, since
# knight-next then says what happened and pings if it comes to that.
# Whether knight-next runs is decided ONCE, here, and the launch below uses the same answer: when the two
# were computed separately, a held job with KNIGHT_FIXUP_ROUNDS=0 skipped its ping AND got no knight-next
# (review, 2026-10-17) — an outcome nobody was told about.
_fst=$(cat "$DIR/status" 2>/dev/null)
_held=0
[ "$_fst" = done-not-pushed ] && [ "${commits:-0}" -gt 0 ] && [ "${KNIGHT_FIXUP_ROUNDS:-2}" -gt 0 ] && _held=1
_next_will=0
{ [ "${KT_AUTO_LAND:-0}" = 1 ] && [ "$_fst" = pushed ]; } && _next_will=1
{ [ "${KT_CONTINUE:-0}" = 1 ] && [ "$_fst" = done-not-pushed ]; } && _next_will=1
[ "$_held" = 1 ] && _next_will=1
case "$_fst" in
    pushed)
        if [ "$_next_will" = 1 ]; then _cs=landing; _cn="It lands by itself if the project allows it; otherwise it waits for you."
        else _cs=waiting; _cn="Say \"merge it\" to Moses to land it."; fi ;;
    live)                  _cs=live;    _cn="Nothing — it is live." ;;
    awaiting-verification) _cs=live;    _cn="Some requirements need a look on the live site." ;;
    done-not-pushed)       _cs=stopped
                           if [ "$_next_will" = 1 ]; then _cn="A follow-up job, or a question for you."
                           else _cn="It waits for you: tell Moses what to do with it."; fi ;;
    *)                     _cs=failed;  _cn="Tell Moses what to do." ;;
esac
_cping=(); [ "$_next_will" = 0 ] && _cping=(--ping)
"$CARD" "$DIR" "$_cs" "$(printf '%s' "${head:-$_fst}" | head -1 | cut -c1-300)" --next "$_cn" \
    "${_cping[@]}" ${REPORT_REPLY+"${REPORT_REPLY[@]}"} >/dev/null 2>&1 || true

# ── What happens next (Brad, 2026-10-17: "build away") ───────────────────────
# A project started with his one-time code carries KT_AUTO_LAND; knight-next decides whether this job
# lands by itself and, after a landing, briefs the next one. DETACHED, as its own transient unit: this
# run is still the job's process, and Knight runs one job at a time, so the next job must not be its
# child. Every override this script was given is handed over, because a transient unit starts clean.
# done-not-pushed too, when the project keeps building: that is how a job that found the scope
# already covered (SCOPE COMPLETE, nothing changed) ends, and the run of jobs should say it finished.
# And a HELD job, on any target: built and committed but stopped by its gate or its review. knight-next
# turns that into a follow-up job (KNIGHT_FIXUP_ROUNDS, default 2) instead of a wait for Brad.
if [ "$_next_will" = 1 ]; then
    nxenv=(--setenv=XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}")
    for v in KNIGHT_HOME KNIGHT_JOBS KNIGHT_TARGETS KNIGHT_LAND_LOG KNIGHT_SLACK_ENV KNIGHT_SLACK_CHANNEL KNIGHT_MFA_CMD MOSES_REGISTRY KNIGHT_START_BIN KNIGHT_LAND_BIN MOSES_MCP_DIR MOSES_PUBLISH_BIN KNIGHT_GLANCE_BIN KNIGHT_LIVE_PROBE KNIGHT_NOTES_DIR KNIGHT_DONE_CHECK_SEC MOSES_STATE; do
        [ -n "${!v+x}" ] && nxenv+=(--setenv="$v=${!v}")
    done
    nxbin="$(dirname "$(readlink -f "$0")")/knight-next"
    if ! { command -v systemd-run >/dev/null 2>&1 \
           && systemd-run --user --collect --quiet --unit="knight-next-$(basename "$DIR")" "${nxenv[@]}" \
                "$nxbin" "$(basename "$DIR")" 2>>"$DIR/next.log"; }; then
        setsid "$nxbin" "$(basename "$DIR")" >> "$DIR/next.log" 2>&1 < /dev/null &
    fi
fi
