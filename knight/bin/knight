#!/usr/bin/env bash
# knight — Brad's software-development agent. Runs headless Claude Code in an isolated clone.
#
#   knight start "add a CSV export button to the trip page"
#   knight start --target moses "make the nav pill match the support page"
#   knight start --incident <id> "fix the 524 on the trip generator"
#   knight targets                  knight status <job-id>       knight list
#   knight cancel <job-id>          knight doctor                knight disable|enable
#   knight reset-budget
#
# WHICH REPOSITORY: the target registry in targets/, one file per repo, and a name that is not in it
# is refused. Defaults to viatica. See targets/README.md for what a target declares and why the
# landing mode (straight to master, or a branch for review) is recorded per repo rather than per job.
#
# ── WHAT MAKES THIS SAFE TO RUN UNATTENDED ───────────────────────────────────
# Not the prompt, and not the deny list. Two structural facts, both verified by test-guards.sh with
# recorded permission denials rather than assumed:
#
#   1. THE SANDBOX. Claude Code confines file access to the working directory — across Write, Edit
#      AND Bash, for reads as well as writes. Knight's cwd is his own clone, so Brad's memory
#      corpus, his Viatica checkout, ~/.claude and /etc are all simply unreachable. This is why the
#      runner NEVER passes --add-dir: that flag is precisely what would open the boundary.
#   2. NO GIT REMOTE WHILE HE RUNS. The clone has none for the entire window the agent is
#      executing, so `git push` has nowhere to go and `Bash(git push:*)` is denied besides. Work
#      reaches Customs only afterwards, and only via the RUNNER: it runs the full test suite and
#      tsc --noEmit itself, and pushes to master only if both are green. The agent never gets push
#      rights, and "the agent said tests pass" is never what authorizes a deploy.
#
# The deny list in guards.env is defense in depth on top of those, NOT the boundary. Withholding a
# single tool proved unreliable during testing — the model substituted another tool to reach the
# same effect — so guards here constrain EFFECTS, not tool names.
#
# ── THE HONEST LIMIT ─────────────────────────────────────────────────────────
# Knight runs as brad, spends Brad's Pro subscription, and — since 2026-08-08 — DEPLOYS. The
# ceilings are real (a wall-clock SIGKILL, a daily count, one job at a time) but they bound
# consumption, not judgement. The test gate is what bounds quality, and it is objective. Brad reads
# the report rather than the diff, so a vague or over-confident report is itself a failed delivery.

set -uo pipefail
. "$(dirname "$(readlink -f "$0")")/../../agent/lib/moses-env.sh"   # whose home, where Moses lives, the operator's settings

KNIGHT_HOME=$MOSES_ROOT/knight
REPOS="$KNIGHT_HOME/repo"          # one clone per target, under here
# OVERRIDABLE SO TESTS DO NOT WRITE HERE. The suite runs jobs with a fake agent — `sleep`, not the
# model — so they cost nothing, but they were landing in the real record: six runs left 40 entries
# against a ceiling of 8, and a genuine `knight start` would have been refused. The suite used to
# raise its own ceiling to 200 to get past that, which fixed the symptom and left the record dirty.
# Job history is something Brad reads; test runs do not belong in it.
JOBS="${KNIGHT_JOBS:-$KNIGHT_HOME/jobs}"
TARGETS="$KNIGHT_HOME/targets"
# The target `knight start` uses when none is named — the operator's, from moses.env. Empty means every
# start must name one, which is the right default for a machine Knight has never worked on.
DEFAULT_TARGET=${KNIGHT_DEFAULT_TARGET:-}
DISABLED="$KNIGHT_HOME/DISABLED"
BUDGET_EPOCH="$KNIGHT_HOME/.budget-epoch"
OPTENV=$MOSES_CONFIG_DIR/knight.env

# shellcheck disable=SC1091
source "$KNIGHT_HOME/guards.env"
# Brad's confirmed examples become tests (#3): written into the job and the brief here, checked by knight-run.
source "$(dirname "$(readlink -f "$0")")/../lib/examples.sh"
mkdir -p "$JOBS"

die() { echo "knight: $*" >&2; exit 1; }

# ── The framework's procedures, in the briefs (2026-10-14) ──────────────────
# The Moses plugin's skills are the procedures every Claude Code session building for Brad follows.
# Knight and Zryachiy run with none of Brad's settings, so they never load the plugin, and their
# briefs had grown their own copies of the same rules. Now each brief pulls the relevant SECTIONS of
# those skills by heading: one text, read in two places, never retyped. Only the principles come
# across — each brief keeps its own output format (Knight's four Slack lines, Zryachiy's verdict
# lines), because code reads those and the skills' report shapes would break it.
#
# CORE, NOT DECORATION: a heading that is gone stops the job before it starts. A renamed section must
# not quietly turn into a brief without the rules.
# Set explicitly, else this checkout when it carries the skills itself (the framework repo), else
# the sibling ../moses-framework beside an instance tree.
if [ -n "${MOSES_FRAMEWORK:-}" ]; then FRAMEWORK=$MOSES_FRAMEWORK
elif [ -d "$MOSES_ROOT/skills" ]; then FRAMEWORK=$MOSES_ROOT
else FRAMEWORK=$(dirname "$MOSES_ROOT")/moses-framework; fi
framework_section() {  # framework_section <skill> <heading> → that section, or fail
    local body
    body=$(awk -v h="## $2" '$0 == h { grab = 1; next } grab && /^## / { exit } grab { print }' \
        "$FRAMEWORK/skills/$1/SKILL.md" 2>/dev/null)
    [ -n "$(printf '%s' "$body" | tr -d '[:space:]')" ] || return 1
    printf '### %s: %s\n%s\n\n' "$1" "$2" "$body"
}
build_procedures() {
    framework_section ship-and-report "Before it ships" \
      && framework_section watch-it-fail "The procedure" \
      && framework_section architecture-diagrams "When to touch it"
}
review_procedures() {
    framework_section watch-it-fail "When reviewing"
}
now() { date +%Y-%m-%dT%H:%M:%S%z; }

# Slack is optional and off by default. The bot token lives in /etc/birdeye/birdeye.env (root-only)
# and Knight runs as brad, so he cannot post unless Brad puts a token somewhere brad can read.
# Rather than widen that token, Knight reports by PULL: ask Moses, via the knight_status tool.
notify() {
    [ -r "$OPTENV" ] || return 0
    # shellcheck disable=SC1090
    local tok chan; tok=$(. "$OPTENV"; printf '%s' "${SLACK_BOT_TOKEN:-}")
    # OVERRIDABLE SO TESTS DO NOT POST INTO THE REAL CHANNEL. Running the suite used to put real
    # "sleep past the ceiling on purpose" and zzz-landing results into #viatica-dev as Knight and
    # Zryachiy — indistinguishable from actual work, in the channel Brad reads. Same shape as the
    # job records, one layer over.
    #
    # An OVERRIDE rather than a "don't post" flag, and set to empty it falls through the existing
    # `-n` guard below. The report IS the deliverable here, so there is deliberately no switch that
    # silences a real run; the only way to be quiet is to be told where to post and be told nowhere.
    # `+x` distinguishes "explicitly set to empty" from "not set at all".
    if [ -n "${KNIGHT_SLACK_CHANNEL+x}" ]; then chan=$KNIGHT_SLACK_CHANNEL; else
        chan=$(. "$OPTENV"; printf '%s' "${SLACK_KNIGHT_CHANNEL:-}"); fi
    [ -n "$tok" ] && [ -n "$chan" ] || return 0
    curl -sS --max-time 10 -X POST https://slack.com/api/chat.postMessage \
        -H "Authorization: Bearer $tok" -H 'Content-type: application/json; charset=utf-8' \
        --data "$(jq -nc --arg c "$chan" --arg t "$1" \
                  '{channel:$c,text:$t,username:"Knight",icon_emoji:":crossed_swords:"}')" >/dev/null 2>&1
}

# Is this job's worker actually alive? A record saying "running" is a CLAIM, not an observation.
#
# Job 20260808-141955-3205674 sat at "running" for 66 minutes with no process, no pid file and no
# brief — the launch had aborted after the record was written. It held the 1/1 slot the whole time,
# so Knight was wedged, and `knight status` reported "running" with a straight face because it only
# ever read the file. The wall-clock SIGKILL was blamed and was entirely innocent: nothing had
# started for it to kill.
#
# So liveness is checked against the process table, and a job claiming to run with a dead or absent
# worker is reconciled to `orphaned` rather than believed.
job_alive() {
    local dir="$1" pid
    [ -f "$dir/pid" ] || return 1
    pid=$(cat "$dir/pid" 2>/dev/null)
    [ -n "$pid" ] || return 1
    kill -0 "$pid" 2>/dev/null
}

reconcile_jobs() {
    local j
    for j in "$JOBS"/*/; do
        [ -r "$j/status" ] || continue
        [ "$(cat "$j/status" 2>/dev/null)" = "running" ] || continue
        if ! job_alive "$j"; then
            echo orphaned > "$j/status"
            [ -s "$j/summary" ] || printf 'orphaned — the record said running but no worker process was alive.\nThe launch aborted, or the worker died without updating its record.\n' > "$j/summary"
        fi
    done
}

running_jobs() {
    local n=0 j
    reconcile_jobs
    for j in "$JOBS"/*/; do
        [ -r "$j/status" ] || continue
        [ "$(cat "$j/status" 2>/dev/null)" = "running" ] && n=$((n+1))
    done
    echo "$n"
}

# Jobs run today, EXCLUDING anything before the last `knight reset-budget`.
#
# The reset is an epoch marker rather than a deletion, because the job directories are the audit
# trail — what was asked, what was decided, what got pushed. Burning the daily budget on testing and
# then wanting the counter back should not cost the record of what that testing did. Job ids sort
# lexicographically (YYYYMMDD-HHMMSS-PID), so a plain string comparison is enough.
today_count() {
    local d n=0 j epoch base
    d=$(date +%Y%m%d)
    epoch=""
    [ -r "$BUDGET_EPOCH" ] && epoch=$(cat "$BUDGET_EPOCH" 2>/dev/null)
    for j in "$JOBS/$d"-*; do
        [ -d "$j" ] || continue
        base=$(basename "$j")
        if [ -n "$epoch" ] && [ "${base:0:15}" \< "$epoch" ]; then continue; fi
        n=$((n+1))
    done
    echo "$n"
}

# ── THE REGISTRY ─────────────────────────────────────────────────────────────
# Knight works on repositories that are written down, and only those. Not a safety theatre: it is
# what lets him take a one-line task naming a project without anyone deciding, per job and in a
# hurry, where green work is allowed to land. `targets/README.md` has the reasoning.
known_targets() {
    local f
    for f in "$TARGETS"/*.env; do [ -e "$f" ] || continue; basename "$f" .env; done
}

# Every failure here names the target and lists the alternatives. "Unknown target" with no list is
# how an agent ends up guessing at a name, and guessing is the behavior this exists to remove.
load_target() {
    local name="$1" f="$TARGETS/$1.env"
    [ -n "$name" ] || die "no target named — pass --target NAME (Knight works on: $(known_targets | tr '\n' ' ')), or set KNIGHT_DEFAULT_TARGET in moses.env"
    if [ ! -f "$f" ]; then
        die "no such target '$name'. Knight works on: $(known_targets | tr '\n' ' ')
Add one in $TARGETS (see $TARGETS/README.md). A repository that is not in the registry is not one Knight touches."
    fi
    KT_DESC=""; KT_SOURCE=""; KT_BRANCH=""; KT_PUSH_MODE=""; KT_PUSH_REMOTE=""; KT_PREP=(); KT_GATE=()
    # shellcheck disable=SC1090
    source "$f"
    TARGET="$name"
    REPO="$REPOS/$name"
    [ -n "$KT_SOURCE" ]        || die "target '$name': no KT_SOURCE"
    [ -d "$KT_SOURCE/.git" ]   || die "target '$name': KT_SOURCE $KT_SOURCE is not a git repository"
    [ -n "$KT_BRANCH" ]        || die "target '$name': no KT_BRANCH"
    [ "${#KT_GATE[@]}" -gt 0 ] || die "target '$name': no KT_GATE — a target with no objective check may not ship work"
    case "$KT_PUSH_MODE" in
        direct|branch) ;;
        *) die "target '$name': KT_PUSH_MODE must be 'direct' or 'branch', not '${KT_PUSH_MODE:-empty}'" ;;
    esac
    # An empty remote means "whatever the source repo pushes to", so the two can never disagree.
    [ -n "$KT_PUSH_REMOTE" ] || KT_PUSH_REMOTE=$(git -C "$KT_SOURCE" remote get-url origin 2>/dev/null)
    [ -n "$KT_PUSH_REMOTE" ] || die "target '$name': KT_PUSH_REMOTE is empty and $KT_SOURCE has no origin to inherit from"
}

ensure_repo() {
    mkdir -p "$REPOS"
    if [ ! -d "$REPO/.git" ]; then
        echo "  provisioning Knight's clone of $TARGET (first run)…"
        git clone -q --no-hardlinks "$KT_SOURCE" "$REPO" || die "clone failed"
        # THE load-bearing line. A clone inherits `origin`; removing it is what makes pushing
        # impossible rather than merely discouraged.
        git -C "$REPO" remote remove origin 2>/dev/null
    fi
    git -C "$REPO" remote | grep -q . && die "Knight's $TARGET clone has a remote — refusing to run until it is removed"

    # READ FROM WHERE WE WRITE. This fetched KT_SOURCE — Brad's own working checkout — while the
    # push goes to its origin. The two diverge the instant Knight pushes, and he then starts his
    # NEXT job against a tree that is missing his own last change.
    #
    # It cost the second end-to-end run (2026-09-04). Knight shipped the deploy marker to master as
    # bfd76c6, Brad confirmed it live, then asked for it to be removed — and Knight correctly
    # reported that `deploy marker` appeared in no file in the tree, because his tree was Brad's
    # local master at e695064, one commit behind. He was not wrong; he was reading a different
    # repository from the one he had written to.
    #
    # The push target is the mainline by definition, so it is the only honest thing to read. Falls
    # back to KT_SOURCE when there is no remote at all, which keeps a purely local target working.
    KT_READ_FROM="${KT_PUSH_REMOTE:-}"
    [ -n "$KT_READ_FROM" ] || KT_READ_FROM="$KT_SOURCE"
    # Fetch by PATH or URL, never by named remote, so no remote is ever created.
    git -C "$REPO" fetch -q "$KT_READ_FROM" "$KT_BRANCH" 2>/dev/null \
        || die "could not fetch $KT_BRANCH from $KT_READ_FROM"
    # LEFTOVERS GO FIRST. The wipe below used to run only after this checkout — but an untracked file the
    # mainline now TRACKS blocks the checkout itself ("would be overwritten"), so the job died before the
    # wipe could help. 2026-10-17: prep had left package-lock.json untracked in the GIS clone, main
    # started tracking it, and the next job failed "could not check out main". Same -e exclusions as below.
    git -C "$REPO" clean -qfd -e node_modules -e .venv
    git -C "$REPO" checkout -q --detach FETCH_HEAD || die "could not check out $KT_BRANCH"

    # Wipe anything the previous job left behind. Not theoretical: a run that wrote a test file but
    # could not execute it left that file untracked, and the NEXT job found it, reported it "already
    # present", verified it, and committed work it had not done. A job must start from the mainline
    # and nothing else, or its report describes a state nobody can reproduce.
    #
    # NOTE THE ABSENCE OF -x. That flag also deletes GITIGNORED files, and Viatica generates its
    # Prisma client into src/generated/prisma, which is gitignored. `clean -fdx` therefore deleted
    # the database client every run; six test files then failed to IMPORT, and the gate correctly
    # reported "the test suite failed" on a change that was only a comment. A confusing way to learn
    # that "clean" and "clean of leftover work" are different operations. Plain -fd removes the
    # untracked leftovers this is here for and leaves build artifacts alone. The same reasoning now
    # protects the Python targets' .venv, which prep builds and the gate runs from.
    git -C "$REPO" reset -q --hard FETCH_HEAD
    git -C "$REPO" clean -qfd -e node_modules -e .venv

    # MOVE THE CLONE'S OWN MAINLINE LABEL TOO. Every job branched from the freshly fetched tip, but the
    # local `$KT_BRANCH` ref was set once, at clone time, and never again. By 2026-09-27 Viatica's
    # read 55 commits behind the real master. The agent, asked to "land this on master", compared
    # against that label, decided master was missing 55 commits, pulled in a stale "prerequisite",
    # and turned a two-commit fix into a conflicting rebase — three blocked runs and a human merge
    # requested for work that was never actually in conflict. Inside the clone, `master` must mean
    # the mainline as it is now. HEAD is detached here, so moving the ref is always safe.
    git -C "$REPO" update-ref "refs/heads/$KT_BRANCH" FETCH_HEAD

    # Prep comes from the target file, and runs HERE — outside the agent. The sandbox has no network,
    # and more importantly a dev agent that cannot run the test suite is barely worth having. Every
    # prep line is written to be idempotent, so this is cheap when there is nothing to do.
    local step
    for step in ${KT_PREP+"${KT_PREP[@]}"}; do
        if ! ( cd "$REPO" && bash -c "$step" >/dev/null 2>&1 ); then
            echo "  ⚠️  prep step failed: $step"
            echo "      Knight may not be able to build or test. Continuing — the gate will say so plainly."
        fi
    done
}

cmd_start() {
    # --target NAME may appear before or after the task, because Moses and Brad both type these and
    # neither should have to remember an order.
    local target="$DEFAULT_TARGET" incident="" acceptance="" base="" quiet=0 run_of="" args=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --target|-t) target="${2:-}"; [ -n "$target" ] || die "--target needs a name (one of: $(known_targets | tr '\n' ' '))"; shift 2 ;;
            --target=*)  target="${1#*=}"; shift ;;
            # The Viatica incident this job is meant to fix. The AGENT never sees a credential and
            # never calls the app; this id travels to the RUNNER, which closes the incident only if
            # the gate went green and the work actually landed. Same shape as push rights: the
            # privileged step belongs to the runner, never to the model.
            --incident)  incident="${2:-}"; [ -n "$incident" ] || die "--incident needs an id from the incident queue"; shift 2 ;;
            --incident=*) incident="${1#*=}"; shift ;;
            # WHAT MUST BE TRUE WHEN IT IS DONE — written by the requester BEFORE any code exists,
            # and handed to the REVIEWER, never to the builder. Brad, 2026-09-04: "I tell Moses what
            # I want, he tasks Knight to build it, he tells Zryachiy what SHOULD be built."
            #
            # This is what closes the gap that a passing gate cannot see: every check in this
            # pipeline asked "is this code correct" and none asked "is this what was asked for", so
            # a flawless change solving the wrong problem shipped clean.
            --acceptance) acceptance="${2:-}"; [ -n "$acceptance" ] || die "--acceptance needs the criteria"; shift 2 ;;
            --acceptance=*) acceptance="${1#*=}"; shift ;;
            # BUILD ON EARLIER WORK. The job's branch starts from <base> instead of the mainline: a
            # follow-up to a held job, or the next piece after one. Until 2026-10-17 Knight was told to
            # "bring that branch's files over" and, with merge blocked in his sandbox, copied them by
            # hand — twice, each time reporting "verified identical". The runner does it now, in git.
            --base)      base="${2:-}"; [ -n "$base" ] || die "--base needs a branch"; shift 2 ;;
            --base=*)    base="${1#*=}"; shift ;;
            # Started by knight-next, not by a person: report only the outcome (knight-next says it),
            # never the start, so a run of jobs is one message and not a running commentary.
            --quiet)     quiet=1; shift ;;
            # The run this job belongs to (its first job's id): it reports on that run's ONE status card
            # instead of starting a card of its own.
            --run-of)    run_of="${2:-}"; shift 2 ;;
            *)           args+=("$1"); shift ;;
        esac
    done
    set -- ${args+"${args[@]}"}
    local task="$*"
    [ -n "$task" ] || die 'usage: knight start [--target NAME] --acceptance "<what must be true>" "<what to build>"'
    # REFUSED HERE RATHER THAN SKIPPED LATER. A job with no acceptance criteria cannot be checked
    # against intent, and "could not look" must never render as "looked and it was fine". Failing at
    # task time costs one retry; failing at review time means the wrong thing already got built.
    if [ -z "$acceptance" ]; then
        die 'every job needs --acceptance: what must be TRUE when this is done, in terms someone can
check without reading the diff. Not a restatement of the task — the observable outcome.
  bad:  --acceptance "remove the Labs entry"
  good: --acceptance "the Labs/bcmdisplay host is absent from the hardware registry; the registry
        still parses; no other host entry changed"'
    fi
    [ -f "$DISABLED" ] && die "Knight is disabled ($(cat "$DISABLED")). Re-enable with: knight enable"
    [ -x "$KNIGHT_CLI" ] || die "claude CLI not found at $KNIGHT_CLI"

    load_target "$target"

    local r; r=$(running_jobs)
    [ "$r" -ge "$KNIGHT_MAX_CONCURRENT" ] && die "$r job(s) already running (max $KNIGHT_MAX_CONCURRENT). One clone, one worker."
    provisioning_now && die "1 job(s) already running (max $KNIGHT_MAX_CONCURRENT): a provision is checking the clone ($(cat "$PROVISIONING"))."
    local c; c=$(today_count)
    [ "$c" -ge "$KNIGHT_MAX_PER_DAY" ] && die "$c jobs already today (max $KNIGHT_MAX_PER_DAY). Knight spends Brad's Pro usage; raise KNIGHT_MAX_PER_DAY if that is deliberate."

    ensure_repo

    local fw_build fw_review
    fw_build=$(build_procedures) && fw_review=$(review_procedures) \
      || die "could not read the framework's procedures from $FRAMEWORK/skills — Knight does not build without them (set MOSES_FRAMEWORK to the framework checkout)"

    local id dir slug branch
    id="$(date +%Y%m%d-%H%M%S)-$$"
    dir="$JOBS/$id"; mkdir -p "$dir"
    slug=$(printf '%s' "$task" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | cut -c1-40 | sed 's/-*$//')
    branch="knight/$slug-${id##*-}"
    printf '%s\n' "$task" > "$dir/task.txt"
    printf '%s\n' "$acceptance" > "$dir/acceptance.txt"
    # Brad's confirmed examples, one per line: the builder must test each, and the runner checks (#3).
    examples_extract "$dir/acceptance.txt" "$dir/examples.txt"
    printf '%s\n' "$branch" > "$dir/branch"
    printf '%s\n' "$TARGET" > "$dir/target"
    [ -n "$incident" ] && printf '%s\n' "$incident" > "$dir/incident"
    printf '%s\n' "$(now)" > "$dir/started"
    # NOT "running" yet — that is only true once a worker exists. Anything that kills this script
    # between here and the launch (an unbound variable, a failed checkout) must leave a job marked
    # failed, never a phantom holding the concurrency slot forever.
    printf 'starting\n' > "$dir/status"
    trap 'if [ ! -f "$dir/pid" ]; then
              printf "failed\n" > "$dir/status"
              printf "launch aborted before the agent started — see the shell error above.\n" > "$dir/summary"
          fi' EXIT

    if [ -n "${base:-}" ]; then
        # The base is a branch Knight pushed to the source, or one still only in this clone.
        git -C "$REPO" rev-parse --verify -q "refs/heads/$base" >/dev/null \
            || git -C "$REPO" fetch -q "$KT_SOURCE" "refs/heads/$base:refs/heads/$base" 2>/dev/null \
            || die "no branch '$base' in the clone or in $KT_SOURCE to build on"
        git -C "$REPO" checkout -q -B "$branch" "$base" || die "could not create branch $branch from $base"
        printf '%s\n' "$base" > "$dir/base"
    else
        git -C "$REPO" checkout -q -B "$branch" || die "could not create branch $branch"
    fi
    [ "${quiet:-0}" = 1 ] && : > "$dir/quiet"
    [ -n "${run_of:-}" ] && [ -d "$JOBS/$run_of" ] && printf '%s\n' "$run_of" > "$dir/run-of"

    # The agent's brief, assembled DIRECTLY INTO THE FILE — never through a shell variable.
    #
    # This was a double-quoted bash string, and it broke exactly as you would expect once the spec
    # contained prose with quotes in it: `Write "None." and nothing more` terminated the string
    # early, so `None.` and `visible` and `behavior` were run as COMMANDS, $brief ended up unbound,
    # and `set -u` killed the script mid-launch. The job record had already been written, so the
    # result was a phantom "running" job holding the concurrency slot with nothing behind it.
    #
    # The static spec now comes from a QUOTED heredoc (<<'SPEC'), which performs no expansion of any
    # kind — quotes, backticks, $(...), apostrophes and newlines are all just bytes. The dynamic
    # parts go through printf '%s', which cannot re-enter the shell either. Same species as the
    # permission-array word-splitting bug: content that looks like syntax must never reach a parser.
    #
    # WHAT IS TARGET-SPECIFIC AND WHAT IS NOT. Everything about how to report, how much to build and
    # how to fail honestly is the same wherever Knight works, and lives here. Everything about what
    # the codebase IS lives in targets/<name>.brief beside the target file, so adding a project is
    # one directory and no edits to this script.
    {
        printf 'You are Knight, a SENIOR software developer working on %s.\n\n' "$KT_DESC"
        cat <<'SPEC'
Work at that level: understand the existing design before changing it, prefer the smallest change
that fully solves the problem, and reuse what is already there instead of adding a parallel way to do
the same thing. Brad does not read your diff — he reads your report and then looks at the result.

SPEC
        printf 'WHERE YOU ARE: an isolated clone at %s, on branch %s. It has NO git\n' "$REPO" "$branch"
        printf 'remote and you cannot push; do not try. File access is sandboxed to this directory.\n\n'

        # How the work ships, stated from the registry rather than from memory — because the two
        # landing modes are genuinely different promises and an agent that assumes the wrong one
        # writes a report that misleads Brad about what is already live.
        printf 'HOW YOUR WORK SHIPS: commit it on this branch. A runner then runs the gate itself:\n'
        local g
        for g in "${KT_GATE[@]}"; do printf '  %s\n' "$g"; done
        if [ "$KT_PUSH_MODE" = direct ]; then
            printf 'If every one of those is green it pushes straight to %s, and that deploys.\n' "$KT_BRANCH"
            printf 'So claiming the tests pass does not make them pass, and a red gate ships nothing.\n\n'
        else
            printf 'If every one of those is green it pushes your branch for a human to review and\n'
            printf 'merge — it does NOT land on %s by itself. This repository is part of the machinery\n' "$KT_BRANCH"
            printf 'that runs you, so a person looks before it moves. Say in your report what merging it\n'
            printf 'would change. A red gate ships nothing.\n\n'
        fi
        printf 'Anything uncommitted is thrown away. Commit in coherent steps with real messages.\n'
        printf 'Run that whole gate yourself with this ONE command, exactly as written — it runs the steps\n'
        printf 'above in order, the same way the runner will, and is the only way to run them all here:\n'
        printf '  %s/knight/bin/knight-gate\n' "$MOSES_ROOT"
        printf 'Shell loops, script files and sh -c are refused, so do not try them. Fix what you break.\n\n'

        # The incident, if this job came from one. Deliberately just the id and a sentence: the agent
        # has no network and no credential, so it can neither look it up nor close it. What it can do
        # is say honestly whether it believes the cause is fixed, which is what the runner needs.
        if [ -n "$incident" ]; then
            printf 'THIS JOB CAME FROM AN INCIDENT: %s\n' "$incident"
            printf 'Something failed for a real person and that is what you are fixing. If your\n'
            printf 'change addresses the cause, say so plainly in *What shipped*. If you fixed\n'
            printf 'something adjacent but NOT the reported failure, say that instead — the incident\n'
            printf 'is closed automatically when this lands, and a wrong close is worse than an open\n'
            printf 'one because it tells everybody the problem is handled.\n\n'
        fi

        # What this codebase is. Optional: a target can be self-evident enough not to need one.
        [ -f "$TARGETS/$TARGET.brief" ] && { cat "$TARGETS/$TARGET.brief"; printf '\n'; }

        cat <<'SPEC'
EXPECT A ONE-LINE BRIEF, AND FILL IN THE REST YOURSELF. Brad sends these from his phone — walking,
traveling, away from a keyboard — so the task will usually be a single sentence with no design
direction in it. That is the normal case, not an oversight, and "he did not say" is not a reason to
build something plain. Before you write anything, LOOK AT HOW THIS CODEBASE ALREADY DOES SIMILAR
THINGS: open the nearest existing files, and carry their structure, naming, spacing and voice into
what you build. Match what is there, not a generic default. A wall of paragraphs where the rest of
the code uses structure is a wrong answer even when every word is accurate.

BUILD THE SMALLEST THING THAT FULLY DELIVERS THE ASK. He reviews on a phone, hours later, so a
sprawling change is expensive to check even when it is good. Do the whole ask — do not quietly
deliver half — but resist widening it, and name anything you deliberately left out in Notes so the
decision is his.

STANDARDS: match the surrounding style and comment density. Add or update tests for what you change.
US English everywhere — color, behavior, traveler, gray — in code, comments and any copy.

FINISH WITH A REPORT. This IS the deliverable — it is the only part Brad reads before going to look
at the result, and he reads it on a phone in Slack. So it is SHORT.

Exactly four lines, in this shape, nothing else after them:

*What shipped* — what the change does in product terms, and what he will see. Not a file list.
  Write it under that name. The RUNNER renames this line from what actually landed — it becomes
  "What this would do" when the work sits on an unmerged branch and "What was tried" when a deploy
  was rolled back — so describe the change plainly and do not claim it is live yourself.
*Decisions* — the judgement calls worth knowing, especially where the request was ambiguous.
*Stoppers* — what you could not do and why. Write None. and nothing more if there were none.
*Notes* — a follow-up or risk worth knowing. None. is a fine answer.

HARD RULES for those four lines:
- ONE line each. No headings on their own line, no blank lines between them, no bullet lists.
- Two sentences maximum per line. Aim for one.
- SINGLE asterisks around the labels. Slack renders *this* as bold; a doubled pair shows up as
  literal asterisks and looks broken.
- No preamble, no sign-off, no restating the task, no summary of your process.

Compress ruthlessly and keep the substance. Nothing visible; comment-only change, behavior
byte-for-byte identical — that beats three sentences saying the same thing. Every clause should
survive the question: would he act differently without this?

IF YOU CANNOT FINISH: commit what genuinely works and say plainly what is incomplete. A
half-finished change honestly described is useful. A confident claim that something works when it
does not is the one outcome to avoid, because he will act on your report without checking the code.

SPEC
        printf 'THE FRAMEWORK'"'"'S PROCEDURES. These sections come from the Moses framework, word for word: the\n'
        printf 'same text every Claude Code session building for Brad follows. They hold alongside the\n'
        printf 'commandments in your system prompt. Where one conflicts with this brief, THE BRIEF WINS: you\n'
        printf 'never push or merge (the runner does), and your report is the four lines above, nothing else.\n\n'
        printf '%s\n\n' "$fw_build"
        printf 'TASK:\n%s\n' "$task"
        examples_brief "$dir/examples.txt"
    } > "$dir/brief.txt"

    # ── The reviewer's brief — written here, read by the runner, never by the builder ──────────
    # Deliberately separate and deliberately short. The reviewer gets the DIFF and the repo, not the
    # task's reasoning: its job is to find what is wrong with the code that exists, not to agree
    # that the author solved the problem they set out to solve. Handing it the builder's own
    # framing is how a second opinion becomes an echo.
    #
    # THE ACCEPTANCE CRITERIA ARE THE EXCEPTION, AND THEY ARE NOT AN ECHO. They are written by the
    # REQUESTER before any code exists — not the builder's account of what they set out to do, and
    # not derived from the diff, which would just be describing whatever happened. That ordering is
    # the whole reason they can be judged against. Brad, 2026-09-04, on why the diff alone was not
    # enough: the pipeline could tell him the code was correct and never that it was what he asked
    # for.
    #
    # The CONFIRMED/PLAUSIBLE split is Atlas's, adopted 2026-09-02: reproduced blocks the push
    # exactly like a red test, suspected-but-unproven is recorded on the commit and the push
    # proceeds. So a hunch can neither quietly stop the build nor quietly disappear.
    {
        cat <<'REVIEWSPEC'
You are reviewing a code change on a branch that has already passed its automated test gate. You did
not write it and you are not fixing it — you have no edit tools, on purpose.

Read the diff at review.diff in the job directory, and read whatever surrounding code you need with
Read and Grep to judge it. The tests passing is a fact you already have; do not re-derive it.

Report ONLY defects the change itself introduces. Pre-existing problems, style preferences and
things you would have done differently are not findings.

OUTPUT FORMAT — nothing else, one finding per line, no preamble and no closing summary:

  CONFIRMED: <file>:<line> — <one sentence: the defect, and the input or state that triggers it>
  MISSED: <criterion> — <one sentence: what the change does instead, or what it left undone>
  PLAUSIBLE: <file>:<line> — <one sentence: what you suspect and what you could not verify>
  UNCHECKED: <criterion> — <one sentence: why a diff cannot show it, and what would>
  CLEAN

Use CONFIRMED only when you can name the concrete case that breaks: an input, a sequence, a state.
That verdict BLOCKS the change from shipping, exactly like a failing test, so a guess must not carry
it. Use PLAUSIBLE when something looks wrong but you could not prove it from the code in front of
you — that is recorded on the commit and does not block. Use CLEAN, alone, when the change is sound
AND every acceptance criterion is met.

A verdict word starts a line ONLY when that line is a finding. With nothing to report, write no
CONFIRMED or MISSED line at all — never "CONFIRMED: none". A line beginning CONFIRMED is read as a
blocking defect.

YOU ARE ALSO CHECKING WHETHER THIS IS THE THING THAT WAS ASKED FOR. The acceptance criteria below
were written before any code existed, by the person who wanted the change — they are not the
author's account of what they attempted. Judge the diff against them one at a time.

  * A criterion the change does not satisfy is MISSED, and MISSED BLOCKS THE PUSH exactly like
    CONFIRMED. Correct code that solves a different problem is not a pass.
  * A criterion you CANNOT JUDGE from the diff and the repo — it is about the running product, another
    branch, a live service, a person's opinion — is UNCHECKED, not MISSED. Say what would settle it.
    It does not block: it goes to the verification ledger for whoever can look at the live thing, and
    it is not a pass either, because you do not SETTLE it. MISSED is for a criterion the diff shows is
    not met. (Until 2026-10-17 this line said "MISSED", and a few lines below said to stay silent about
    what you cannot settle; Zryachiy followed the first, and correct work sat blocked on criteria no
    diff could answer — 5 of 21 reviewed jobs.)
  * Extra work beyond the criteria is not automatically wrong, but scope nobody asked for on a
    change that ships straight to production IS a finding — say so as PLAUSIBLE.

SAY WHICH CRITERIA YOU ACTUALLY SETTLED. After the verdict lines, add one line per criterion you
could confirm FROM THE DIFF ITSELF:

  SETTLED: <number> — <what in the diff shows it>

Only for criteria a diff can answer: a file deleted, a string absent from the tree, no other test
touched, the gate green. NOT for anything about the running product — how a page renders, what a
logged-in user sees, whether a deploy took — because the diff cannot show you that, and claiming it
would close a row nobody checked.

Say nothing about criteria you cannot settle. Silence there is correct: the ones you leave alone go
to whoever can actually look at the live site, and an unverified row costs a moment while a wrongly
closed one costs the whole point of the ledger.

If you cannot review it — the diff is unreadable, or too large to judge — say so with a CONFIRMED
line naming that as the reason. A review that could not run must never read as a review that passed.
REVIEWSPEC
        printf '\nTHE FRAMEWORK'"'"'S REVIEW RULES, word for word from the Moses framework, alongside the\n'
        printf 'commandments in your system prompt. The OUTPUT FORMAT above wins over how they say to report:\n'
        printf 'a surface you could not review becomes a MISSED, PLAUSIBLE or UNCHECKED line, never prose, and\n'
        printf 'nothing else goes on the page.\n\n%s\n' "$fw_review"
        printf '\nACCEPTANCE CRITERIA — what must be true for this change to be done:\n%s\n' \
            "$(cat "$dir/acceptance.txt" 2>/dev/null)"
        printf '\nThe job directory is: %s\n' "$dir"
        examples_review_brief "$dir/examples.txt"
    } > "$dir/review-brief.txt"

    # Detached, in its own process group so `cancel` kills the whole tree. The worker is a separate
    # script because the permission lists are arrays; threading those through `bash -c` is what
    # flattened them into a string and silently broke every multi-word rule.
    # ITS OWN UNIT, NOT A CHILD OF WHOEVER ASKED (2026-10-17). `setsid nohup … &` gives a new session but
    # leaves the job in the CALLER'S CGROUP, and systemd kills a unit's whole cgroup when it ends. So a
    # job started by knight-next (a transient unit that exits a second later) died at once, silently,
    # with "running" on its record — the first chained GIS job, 11:06 that day. The same was true of a
    # job started from an MCP server that then restarted. knight-land hit this exact trap in September
    # (see knight-land); the fix is the same: a transient user unit of its own, given the caller's whole
    # environment, because a transient unit starts clean and the job relies on what nohup used to pass.
    local unit="knight-job-$id" pid="" v envs=()
    for v in $(compgen -e); do
        case "$v" in _|PWD|OLDPWD|SHLVL|BASH_*|INVOCATION_ID|JOURNAL_STREAM|SYSTEMD_EXEC_PID|MANAGERPID|NOTIFY_SOCKET) continue ;; esac
        envs+=(--setenv="$v=${!v}")
    done
    : > "$dir/nohup.log"
    if command -v systemd-run >/dev/null 2>&1 \
       && systemd-run --user --collect --quiet --unit="$unit" "${envs[@]}" \
            -p StandardOutput="append:$dir/nohup.log" -p StandardError="append:$dir/nohup.log" \
            "$KNIGHT_HOME/bin/knight-run" "$dir" "$REPO" "$branch" "$TARGET" "$incident" 2>>"$dir/nohup.log"; then
        # The worker's real pid, so `cancel` and job_alive read the process, not systemd-run's.
        for _ in $(seq 1 20); do
            pid=$(systemctl --user show -p MainPID --value "$unit" 2>/dev/null)
            [ -n "$pid" ] && [ "$pid" != 0 ] && break
            [ "$(cat "$dir/status" 2>/dev/null)" = starting ] || break     # already finished
            sleep 0.1
        done
        printf '%s\n' "$unit" > "$dir/unit"
    else
        # No user systemd (a container, a test box): the old way, which a caller's exit can kill.
        setsid nohup "$KNIGHT_HOME/bin/knight-run" "$dir" "$REPO" "$branch" "$TARGET" "$incident" \
          >> "$dir/nohup.log" 2>&1 &
        pid=$!
    fi

    echo "${pid:-0}" > "$dir/pid"
    printf 'running\n' > "$dir/status"
    trap - EXIT
    # THE STATUS CARD (2026-10-17): one Slack message per run, edited at every step — see lib/card.py.
    # A job in a run (knight-next's follow-ups and next pieces) adds a line to that run's card.
    if [ -n "${run_of:-}" ] && [ -f "$dir/run-of" ]; then
        "$KNIGHT_HOME/lib/card.py" "$dir" building "Job \`$id\` started: $(printf '%s' "$task" | head -1 | cut -c1-120)" \
            --next "His checks and review run when he finishes (up to $((KNIGHT_TIMEOUT_SEC/60)) minutes)." >/dev/null 2>&1 || true
    else
        "$KNIGHT_HOME/lib/card.py" "$dir" building "Job \`$id\` started on branch \`$branch\`." \
            --next "His checks and review run when he finishes (up to $((KNIGHT_TIMEOUT_SEC/60)) minutes); it $([ "$KT_PUSH_MODE" = direct ] && echo "deploys if they pass" || echo "waits on a branch or lands by itself if they pass")." >/dev/null 2>&1 || true
    fi

    echo "started  $id"
    echo "target   $TARGET"
    echo "branch   $branch"
    echo "lands    $([ "$KT_PUSH_MODE" = direct ] && echo "$KT_BRANCH on $KT_PUSH_REMOTE" || echo "$branch on $KT_PUSH_REMOTE — for review, not merged")"
    echo "ceiling  $((KNIGHT_TIMEOUT_SEC/60)) minutes"
    echo
    echo "Check with: knight status $id"
}

cmd_status() {
    local id="${1:-}"; [ -n "$id" ] || die "usage: knight status <job-id>"
    local dir="$JOBS/$id"; [ -d "$dir" ] || die "no job $id"
    reconcile_jobs
    local st; st=$(cat "$dir/status" 2>/dev/null || echo unknown)
    echo "job      $id"
    echo "status   $st"
    echo "target   $(cat "$dir/target" 2>/dev/null || echo "viatica (recorded before targets existed)")"
    echo "task     $(head -1 "$dir/task.txt" 2>/dev/null)"
    # WHAT WAS SUPPOSED TO BE TRUE, and what actually happened after the push. Without these,
    # `knight status` answered "did it run" and never "did it work" — which is the question the
    # person reading it is actually asking.
    [ -s "$dir/acceptance.txt" ] && {
        echo "acceptance"
        sed 's/^/         /' "$dir/acceptance.txt"
    }
    [ -s "$dir/deploy-state" ] && echo "deploy   $(cat "$dir/deploy-state"): $(cat "$dir/deploy-why" 2>/dev/null)"
    # WHAT IS STILL OPEN, and who owes it. A deploy that landed is not a request that is done.
    [ -s "$dir/verification.json" ] && python3 - "$dir/verification.json" <<'PY'
import json, sys
d = json.load(open(sys.argv[1]))
rows = d["criteria"]
open_rows = [c for c in rows if c["status"] == "unverified"]
print(f"verify   {len(rows) - len(open_rows)}/{len(rows)} verified" +
      (f" — {len(open_rows)} OPEN" if open_rows else " — complete"))
for c in rows:
    mark = "✓" if c["status"] == "verified" else " "
    who = "" if c["status"] == "verified" else f"  ← {c['checkable_by']}"
    print(f"         [{mark}] {c['criterion'][:88]}{who}")
PY
    echo "branch   $(cat "$dir/branch" 2>/dev/null)"
    echo "started  $(cat "$dir/started" 2>/dev/null)"
    [ -f "$dir/ended" ] && echo "ended    $(cat "$dir/ended")"
    if [ "$st" = "running" ]; then
        local s; s=$(( $(date +%s) - $(date -d "$(cat "$dir/started")" +%s) ))
        echo "elapsed  $((s/60))m $((s%60))s  of $((KNIGHT_TIMEOUT_SEC/60))m"
        # State the observation, not just the record — "running" used to mean only "not yet marked
        # finished", which is how a job with no process at all reported healthy for over an hour.
        if job_alive "$dir"; then
            echo "worker   pid $(cat "$dir/pid") alive"
        else
            echo "worker   NO LIVE PROCESS — the record is stale; re-run this command to reconcile it"
        fi
    fi
    if [ "$st" = "orphaned" ]; then
        echo
        echo "  This job never really ran, or died without recording it. Nothing was pushed."
        echo "  It no longer holds the concurrency slot."
    fi
    [ -s "$dir/summary" ] && { echo; sed 's/^/  /' "$dir/summary"; }
    # THE WHOLE RUN, in one log (#6): this job and every follow-up and next piece in its run, step by
    # step — the same lines as the run's status card, kept in full where the card shows the latest.
    local run_dir="$dir" origin; origin=$(cat "$dir/run-of" 2>/dev/null || true)
    [ -n "$origin" ] && [ -d "$JOBS/$origin" ] && run_dir="$JOBS/$origin"
    [ -s "$run_dir/run.log" ] && { echo; echo "the run ($(basename "$run_dir"), every step):"; sed 's/^/  /' "$run_dir/run.log"; }
    if [ -s "$dir/result.json" ]; then
        echo
        echo "Knight's report:"
        python3 -c "
import json,sys
try: d=json.load(open('$dir/result.json'))
except Exception as e: print('  (result unreadable:',e,')'); raise SystemExit
print('  ' + (d.get('result') or '(no text)').replace(chr(10), chr(10)+'  ')[:2500])" 2>/dev/null
    fi
    if [ "$st" = "timeout" ]; then
        echo
        echo "  Hit the wall-clock ceiling and was killed. Whatever he committed is still on the branch."
    fi
}

cmd_list() {
    local any=0 d
    # TITLES ARE CUT BY CHARACTERS, NOT BYTES. `head -c 60` counts bytes, so a title with an em dash
    # at byte 60 was cut mid-character (e2 80 …) and the MCP tool that reads this list crashed on
    # decode (2026-10-03, "Docs-only job: write docs/stripe-live-mode-checklist.md —"). iconv -c drops a
    # partial trailing character whatever the locale; first line only, so a multi-line brief stays one row.
    for d in $(ls -1dr "$JOBS"/*/ 2>/dev/null | head -15); do
        any=1
        printf '  %-24s %-8s %s\n' "$(basename "$d")" "$(cat "$d/status" 2>/dev/null)" "$(head -n1 "$d/task.txt" 2>/dev/null | head -c 60 | iconv -f UTF-8 -t UTF-8 -c 2>/dev/null)"
    done
    [ "$any" -eq 0 ] && echo "  no jobs yet"
    # Said explicitly: the line above returns 1 whenever there ARE jobs, so `knight list` exited 1 on
    # every normal call (found 2026-10-04 testing Atlas's question). iconv's own nonzero exit on a cut
    # character is harmless — its output is an argument to printf, whose status is the one that counts.
    # Not `cut -c`: the coreutils here cuts by byte too, and splits the em dash exactly as head -c did.
    return 0
}

cmd_cancel() {
    local id="${1:-}"; [ -n "$id" ] || die "usage: knight cancel <job-id>"
    local dir="$JOBS/$id"; [ -d "$dir" ] || die "no job $id"
    local pid; pid=$(cat "$dir/pid" 2>/dev/null)
    [ -n "$pid" ] && kill -TERM -- "-$pid" 2>/dev/null
    # A job in its own unit: stopping the unit takes everything it started with it.
    [ -r "$dir/unit" ] && systemctl --user stop "$(cat "$dir/unit")" >/dev/null 2>&1
    sleep 2
    [ -n "$pid" ] && kill -KILL -- "-$pid" 2>/dev/null
    echo cancelled > "$dir/status"
    echo "cancelled $id (work committed so far is still on its branch)"
}

# Provision a target's clone and run its prep, without starting an agent.
#
# Adding a target is the moment its gate is most likely to be wrong — a missing dependency, a test
# runner that needs a path set, a lockfile step nobody thought of. Discovering that from a real job
# costs an hour of Brad's allowance and produces a report about a failure that has nothing to do with
# the task. This makes the first run free.
# PROVISION SHARES THE CLONE WITH THE JOBS. It resets and cleans knight/repo/<target>, preps it and
# runs the whole gate there, so it must never run under a job, nor a job start under it (review,
# 2026-10-18: knight-next now runs it unattended, to prove a finished project is green). A marker
# with its pid keeps `knight start` out while it runs; a running job keeps it out.
PROVISIONING="$KNIGHT_HOME/.provisioning"
provisioning_now() { local pid; pid=$(cut -d' ' -f1 "$PROVISIONING" 2>/dev/null) && [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; }

cmd_provision() {
    local target="${1:-$DEFAULT_TARGET}"
    load_target "$target"
    reconcile_jobs
    local r; r=$(running_jobs)
    [ "$r" -gt 0 ] && die "$r job(s) already running — provision resets the clone they work in, so it waits for them."
    provisioning_now && die "a provision is already running ($(cat "$PROVISIONING"))."
    printf '%s %s\n' "$$" "$target" > "$PROVISIONING"
    local glog; glog=$(mktemp "${TMPDIR:-/tmp}/knight-provision-gate.XXXXXX")
    # Expanded NOW: the trap runs when the script exits, after this function's locals are gone. Written
    # with single quotes it read an unset $glog, errored under set -u, and left the marker behind.
    # shellcheck disable=SC2064
    trap "rm -f '$PROVISIONING' '$glog'" EXIT
    ensure_repo
    echo "  clone      $REPO"
    echo "  at         $(git -C "$REPO" log -1 --format='%h %s' 2>/dev/null)"
    echo
    echo "  running the gate as the runner would:"
    local step rc=0
    for step in "${KT_GATE[@]}"; do
        printf '    %s\n' "$step"
        if ( cd "$REPO" && bash -c "$step" >"$glog" 2>&1 ); then
            echo "      green"
        else
            echo "      RED — this target cannot ship work until this passes:"
            tail -15 "$glog" | sed 's/^/        /'
            rc=1
            break
        fi
    done
    return $rc
}

# One line per target, so "which repos can Knight touch" is answerable without reading any code.
cmd_targets() {
    local t
    echo "Knight's targets — a name not listed here is refused."
    for t in $(known_targets); do
        ( load_target "$t"
          printf '\n  %s\n' "$t"
          printf '    %-14s %s\n' "what"   "$KT_DESC"
          printf '    %-14s %s\n' "source" "$KT_SOURCE ($KT_BRANCH)"
          printf '    %-14s %s\n' "gate"   "${KT_GATE[0]}"
          local g; for g in "${KT_GATE[@]:1}"; do printf '    %-14s %s\n' "" "$g"; done
          if [ "$KT_PUSH_MODE" = direct ]; then
              printf '    %-14s %s\n' "green work" "pushed to $KT_BRANCH on $KT_PUSH_REMOTE"
          else
              printf '    %-14s %s\n' "green work" "pushed as knight/<slug> to $KT_PUSH_REMOTE — a human merges it"
          fi
          printf '    %-14s %s\n' "clone" "$([ -d "$REPOS/$t/.git" ] && echo "$REPOS/$t" || echo "not yet provisioned")"
        )
    done
    echo
    echo "  Add one: $TARGETS/<name>.env — see $TARGETS/README.md"
}

cmd_doctor() {
    echo "Knight preflight"
    printf '  %-34s %s\n' "claude CLI" "$([ -x "$KNIGHT_CLI" ] && "$KNIGHT_CLI" --version 2>/dev/null || echo "MISSING at $KNIGHT_CLI")"
    printf '  %-34s %s\n' "kill switch" "$([ -f "$DISABLED" ] && echo "ENGAGED — $(cat "$DISABLED")" || echo "off")"
    printf '  %-34s %s\n' "jobs running" "$(running_jobs) / $KNIGHT_MAX_CONCURRENT"
    local orph; orph=$(grep -lx orphaned "$JOBS"/*/status 2>/dev/null | wc -l)
    [ "${orph:-0}" -gt 0 ] && printf '  %-34s %s\n' "orphaned jobs (never ran)" "$orph"
    printf '  %-34s %s\n' "jobs today" "$(today_count) / $KNIGHT_MAX_PER_DAY"
    printf '  %-34s %s\n' "wall-clock ceiling" "$((KNIGHT_TIMEOUT_SEC/60)) min"
    printf '  %-34s %s\n' "model / effort" "$KNIGHT_MODEL / $KNIGHT_EFFORT"
    printf '  %-34s %s\n' "Slack report" "$([ -r "$OPTENV" ] && echo "configured" || echo "NOT configured — no completion report will be posted")"
    case " ${KNIGHT_DENY[*]} " in *--add-dir*) echo "    ⚠️  --add-dir present — the sandbox boundary would be open";; esac

    # Every target, every time. A registry is only worth having if a broken entry is visible before a
    # job is spent on it, and the failures below are all ones that cost real time to discover late.
    local t
    for t in $(known_targets); do
        echo
        echo "  target: $t"
        if ! ( load_target "$t" ) >/dev/null 2>&1; then
            printf '    %-32s %s\n' "registry entry" "BROKEN:"
            ( load_target "$t" ) 2>&1 | sed 's/^/        /'
            continue
        fi
        ( load_target "$t"
          printf '    %-32s %s\n' "source" "$KT_SOURCE ($KT_BRANCH)"
          printf '    %-32s %s\n' "clone" "$([ -d "$REPO/.git" ] && echo present || echo "not yet provisioned")"
          if [ -d "$REPO/.git" ]; then
              local rem; rem=$(git -C "$REPO" remote | tr '\n' ' ')
              printf '    %-32s %s\n' "clone remotes (must be none)" "${rem:-none}"
              [ -n "$rem" ] && echo "        ⚠️  A remote exists. Knight could push. Remove it before running."
          fi
          # REACH the remote, don't just name it. Printing the URL is a declaration; `ls-remote` is
          # the behavior. Knight spent ten minutes building a page, went green on 231 tests, and only
          # then discovered git could not authenticate — because the configured URL was https with no
          # credentials on this box. That is an hour of Brad's Pro allowance to learn something one
          # network call answers in a second, before any work starts.
          local reach
          if reach=$(GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND='ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new' \
                     git ls-remote --heads "$KT_PUSH_REMOTE" "$KT_BRANCH" 2>&1); then
              if [ -n "$reach" ]; then
                  printf '    %-32s %s\n' "push target" "$KT_PUSH_REMOTE — reachable ✓"
              else
                  printf '    %-32s %s\n' "push target" "reachable, but '$KT_BRANCH' does not exist there"
              fi
          else
              printf '    %-32s %s\n' "push target" "$KT_PUSH_REMOTE"
              echo "        ⚠️  CANNOT REACH IT — a green build will build and then fail to push:"
              printf '%s\n' "$reach" | head -2 | sed 's/^/            /'
          fi
          printf '    %-32s %s\n' "gate" "${KT_GATE[0]}"
          local g; for g in "${KT_GATE[@]:1}"; do printf '    %-32s %s\n' "" "$g"; done
          printf '    %-32s %s\n' "green work lands" "$([ "$KT_PUSH_MODE" = direct ] && echo "$KT_BRANCH — deploys" || echo "a branch — a human merges it")"
        )
    done
}

case "${1:-}" in
    start)  shift; cmd_start "$@" ;;
    status) shift; cmd_status "$@" ;;
    list)   cmd_list ;;
    cancel) shift; cmd_cancel "$@" ;;
    doctor) cmd_doctor ;;
    targets) cmd_targets ;;
    provision) shift; cmd_provision "${1:-}" ;;
    reset-budget)
        date +%Y%m%d-%H%M%S > "$BUDGET_EPOCH"
        echo "Daily budget reset — $(today_count)/$KNIGHT_MAX_PER_DAY used."
        echo "Earlier jobs are still on disk; they just no longer count against today."
        ;;
    disable) printf '%s — disabled by hand\n' "$(now)" > "$DISABLED"; echo "Knight disabled." ;;
    enable)  rm -f "$DISABLED"; echo "Knight enabled." ;;
    *) sed -n '2,8p' "$0" | sed 's/^# \?//' ;;
esac
