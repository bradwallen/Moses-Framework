# Moses — your settings. NOT secrets (the Slack tokens are in slack.env). Copy OUTSIDE this repo:
#   install -m 600 config/moses.env.example ~/.config/moses/moses.env
#
# Every Moses script reads this file itself (agent/lib/moses_env.py, agent/lib/moses-env.sh), however
# it was started — a timer, the CLI, Knight, the standup. The process environment overrides it; it
# overrides the code's neutral defaults. Nothing personal is written in the code: it is all here.

# ── Who and where ─────────────────────────────────────────────────────────────────────────────────────
# MOSES_OWNER_SLACK_ID  the one person who may confirm a proposed task or lift the safeword.
#                       Anyone can STOP him; only this person restarts him.
# MOSES_CHAT_CHANNELS   channel ids, space-separated, where he is a conversational participant.
#                       EMPTY MEANS OFF EVERYWHERE — he is a reporting surface until you say otherwise.
# MOSES_ALARM_CHANNELS  where a persona's trouble report gets diagnosed. Usually your ops channel.
MOSES_OWNER_SLACK_ID=
MOSES_OWNER_NAME=
MOSES_CHAT_CHANNELS=
MOSES_ALARM_CHANNELS=
# MOSES_PEOPLE=U0123ABCD:Name,U0456EFGH:Name   names known without asking Slack

# Where the watchdogs post (liveness, dead-man, inbox) and where a deploy reports. Usually ops.
MOSES_ALARM_CHANNEL=
MOSES_LIVENESS_CHANNEL=
MOSES_INBOX_CHANNEL=
SLACK_TEST_CHANNEL=

# ── The model ─────────────────────────────────────────────────────────────────────────────────────────
# Moses shells out to the `claude` CLI on YOUR subscription. There is deliberately no API key here:
# a Pro plan covers Claude Code, not pay-per-token, and adding one should be a decision made out
# loud rather than a line quietly added.
MOSES_CHAT_MODEL=claude-opus-5
MOSES_CHAT_EFFORT=low
MOSES_CHAT_DAILY_USD=40.00

# ── MCP ───────────────────────────────────────────────────────────────────────────────────────────────
# Lets Moses read his own memory in Slack. Bind it to a private address — the bind IS the auth. The
# server's own bind address goes in mcp.env (MOSES_MCP_HOST=…), which its unit loads.
MOSES_MCP_URL=http://127.0.0.1:8765/mcp

# ── Optional: your other projects ─────────────────────────────────────────────────────────────────────
# MOSES_ARCH_DOCS="/path/to/project/docs/ARCHITECTURE.md …"   held to what is running, like Moses's own
# ZRYACHIY_VIATICA=/path/to/product            the checkout Zryachiy (the explorer) tests
# MOSES_PLAYWRIGHT_DIR=/path/to/product        a checkout with Playwright installed, for the dashboard test
# MOSES_TOOL_WALL_EXPLORE_TS=/path/to/product/e2e/explore.ts
# MOSES_TOOL_WALL_DIRS=/path/to/product/e2e:/path/to/product/scripts

# ── Optional: moses-inventory (writes ~/.claude/memory/infrastructure.md daily) ───────────────────────
# MOSES_INVENTORY_CONFIG_FILES=/path/a.env:/path/b.env     config files to track (names, never values)
# MOSES_WATCH_REPOS=/path/to/repo:/path/to/other
# MOSES_BACKUP_DIRS=/path/to/backups
# MOSES_MUST_NOT_REACH="Whose|hostname|100.x.y.z"          checked with ICMP through the tailnet
# Your own description of what runs where goes in ~/.config/moses/estate.md, included verbatim.
